@page "/partida_crea/{SubPre_Id}"
@using Newtonsoft.Json
@using MudBlazor
@using Model.DTO.v1
@inject IHttpClientFactory ClientFactory
@inject NavigationManager NavigationManager
@using Blazored.LocalStorage
@using System.Net.Http.Headers
@using System.Text
@using System.Net
@using System.Reflection.Metadata
@inject ILocalStorageService localStorage
@using Microsoft.JSInterop
@inject IJSRuntime JSRuntime
@using System.Globalization;

<PageTitle>Crear SubPresupuesto</PageTitle>

<MudGrid>
    <MudItem xs="12">
        <MudPaper Class="pa-4" Elevation="3">
            <MudGrid>
                <MudItem xs="6">
                    <MudText Typo="Typo.h5" Color="Color.Primary" Class="ml-2">Agregar Partida en:
                    </MudText>
                </MudItem>
                <MudItem xs="6" Class="ml-2">
                    <MudText Typo="Typo.h6" Color="Color.Primary">
                        @(subpresupuesto.FirstOrDefault()?.SubPre_Nombre ?? "N/A")
                    </MudText>
                </MudItem>
            </MudGrid>
        </MudPaper>
    </MudItem>
    <section style="max-width:600px; margin: 0 auto;">
        <MudItem xs="12">
            <MudPaper Class="pa-5" Elevation="3">
                <MudForm Model="@partida" @ref="form" OnValidSubmit="CrearPartida">
                    <MudTextField @bind-Value="partida.Par_Nombre" Label="Nombre" Required="true" Class="mud-width-full" />
                    <MudNumericField @bind-Value="partida.Par_RenManObra" Label="Rendimiento de Mano de Obra" Required="true" Class="mud-width-full" />
                    <MudNumericField @bind-Value="partida.Par_RenEquipo" Label="Rendimiento de Equipos" Required="true" Class="mud-width-full" />
                    <MudGrid Class="align-center" Spacing="2">
                        <MudItem xs="12" sm="8" md="8" lg="8">
                            <MudAutocomplete T="DTO_Unidad_Medida_Obten"
                                                Label="Unidad de Medida"
                                                @bind-Value="selectedUnidadMedida"
                                                ToStringFunc="@(unid => unid?.UniMed_Nombre ?? "Seleccione Unidad de Medida")"
                                                SearchFunc="@SearchUnidadMedidas"
                                                Required="true"
                                                Dense="true" />
                        </MudItem>
                        <MudItem xs="12" sm="4" md="4" lg="4">
                        <MudTextField @bind-Value="selectedUnidadMedida.UniMed_Abreviatura" Variant="Variant.Filled" Disabled="true" />
                        </MudItem>
                    </MudGrid>

                    <MudItem Class="d-flex justify-center align-center" xs="12" style="gap: 16px;">
                        <MudButton Variant="Variant.Filled" 
                        Color="Color.Primary" 
                        Size="Size.Small" 
                        Disabled="@_processing" 
                        EndIcon="@Icons.Material.Filled.Send" 
                        OnClick="@(async () => await CrearPartida())">
                            @if (_processing)
                            {
                                <MudProgressCircular Class="ms-n1" Size="Size.Small" Indeterminate="true" Color="Color.Inherit" />
                                <MudText Class="ms-2">Creando...</MudText>
                            }
                            else
                            {
                                <MudText>Crear</MudText>
                            }
                        </MudButton>
                        <MudButton Variant="Variant.Filled"
                                   StartIcon="@Icons.Material.Filled.ArrowCircleLeft"
                                   Color="Color.Secondary"
                                   Size="Size.Small"
                                   OnClick="@(async () => await JSRuntime.InvokeVoidAsync("history.back"))">
                            VOLVER
                        </MudButton>
                    </MudItem>
                </MudForm>
                @if (!string.IsNullOrEmpty(errorMessage))
                {
                    <MudAlert Severity="Severity.Error">@errorMessage</MudAlert>
                }
            </MudPaper>
        </MudItem>
    </section>
</MudGrid>


@code {
    [Parameter] public string SubPre_Id { get; set; }
    private MudForm? form;
    private DTO_Partida_Crea partida = new DTO_Partida_Crea();
    private List<DTO_Unidad_Medida_Obten> unidadmedidas = new List<DTO_Unidad_Medida_Obten>();
    private DTO_Unidad_Medida_Obten selectedUnidadMedida { get; set; } = new DTO_Unidad_Medida_Obten();
    private IEnumerable<DTO_SubPresupuesto_Obten_x_Id> subpresupuesto = new List<DTO_SubPresupuesto_Obten_x_Id>();

    private string errorMessage = string.Empty;
    private bool _processing = false;

    protected override async Task OnInitializedAsync()
    {
        await LoadSubPresupuesto();
        await GetUnidadMedida();
    }
    private async Task LoadSubPresupuesto()
    {
        _processing = true;
        try
        {
            var client = ClientFactory.CreateClient("ApiPRESUPUESTOS");
            client.DefaultRequestHeaders.Authorization = new AuthenticationHeaderValue("Bearer",
                await localStorage.GetItemAsync<string>("authToken"));

            var response = await client.GetAsync($"api/v1/SubPresupuesto/Obten_x_Id/{SubPre_Id}");

            if (response.IsSuccessStatusCode)
            {
                var responseBody = await response.Content.ReadAsStringAsync();
                var result = JsonConvert.DeserializeObject<DTO_Response<DTO_SubPresupuesto_Obten_x_Id>>(responseBody);

                if (result?.Data != null)
                {
                    subpresupuesto = new List<DTO_SubPresupuesto_Obten_x_Id> { result.Data };
                }
                else
                {
                    subpresupuesto = new List<DTO_SubPresupuesto_Obten_x_Id>();
                }
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error: {ex.Message}";
        }
        finally
        {
            _processing = false;
            StateHasChanged();
        }
    }
    // private async Task<IEnumerable<DTO_Unidad_Medida_Obten>> SearchUnidadMedidas(string searchText)
    // {
    //     if (string.IsNullOrEmpty(searchText))
    //         return unidadmedidas;

    //     return unidadmedidas.Where(unid => unid.UniMed_Nombre.Contains(searchText, StringComparison.OrdinalIgnoreCase));
    // }
    private async Task<IEnumerable<DTO_Unidad_Medida_Obten>> SearchUnidadMedidas(string searchText)
    {
        if (string.IsNullOrEmpty(searchText))
            return unidadmedidas;

        // Normaliza y quita diacríticos (tildes) de ambas cadenas
        return unidadmedidas.Where(unid =>
            RemoveDiacritics(unid.UniMed_Nombre ?? "")
                .Contains(RemoveDiacritics(searchText), StringComparison.OrdinalIgnoreCase));
    }

    // Método auxiliar para quitar tildes y diacríticos
    private static string RemoveDiacritics(string text)
    {
        if (string.IsNullOrWhiteSpace(text))
            return text;

        text = text.Normalize(NormalizationForm.FormD);
        var chars = text.Where(c => CharUnicodeInfo.GetUnicodeCategory(c) != UnicodeCategory.NonSpacingMark).ToArray();
        return new string(chars).Normalize(NormalizationForm.FormC);
    }
    private async Task GetUnidadMedida()
    {
        try
        {
            var client = ClientFactory.CreateClient("ApiPRESUPUESTOS");
            var token = await localStorage.GetItemAsync<string>("authToken");
            if (token != null)
            {
                client.DefaultRequestHeaders.Authorization = new AuthenticationHeaderValue("Bearer", token);
            }

            var response = await client.GetAsync("api/v1/Unidad_Medida/Obten");
            Console.WriteLine($"Response Status: {response.StatusCode}");

            if (response.IsSuccessStatusCode)
            {
                string responseBody = await response.Content.ReadAsStringAsync();
                Console.WriteLine($"Response Body: {responseBody}");
                var result = JsonConvert.DeserializeObject<DTO_Response<List<DTO_Unidad_Medida_Obten>>>(responseBody);

                if (result != null && result.IsSuccessful)
                {
                    unidadmedidas = result.Data;
                    Console.WriteLine($"UnidadMedida Count: {unidadmedidas.Count}");
                }
                else
                {
                    Console.WriteLine("Response not successful or no data.");
                }
            }
            else
            {
                Console.WriteLine($"Error: {response.StatusCode}");
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error al cargar unidades de medida: {ex.Message}";
            Console.WriteLine(ex.Message);
        }
        StateHasChanged();
    }
    private async Task CrearPartida()
    {
        if (form != null && form.IsValid)
        {
            _processing = true;
            StateHasChanged();

            try
            {
                // Prepara el objeto para enviar al backend
                var PartidaParaEnviar = new
                {
                    Par_Nombre = partida.Par_Nombre,
                    Par_RenManObra = partida.Par_RenManObra,
                    Par_RenEquipo = partida.Par_RenEquipo,
                    UniMed_Nombre = selectedUnidadMedida?.UniMed_Nombre,
                    SubPre_Id = SubPre_Id,
                };

                var client = ClientFactory.CreateClient("ApiPRESUPUESTOS");
                var token = await localStorage.GetItemAsync<string>("authToken");
                if (token != null)
                {
                    client.DefaultRequestHeaders.Authorization = new AuthenticationHeaderValue("Bearer", token);
                }

                var content = new StringContent(JsonConvert.SerializeObject(PartidaParaEnviar),
                    Encoding.UTF8, "application/json");

                var response = await client.PostAsync($"api/v1/Partida/Crea", content);
                Console.WriteLine($"Response Status: {response.StatusCode}");

                if (response.IsSuccessStatusCode)
                {
                    Console.WriteLine("Partida creada exitosamente.");
                    await JSRuntime.InvokeVoidAsync("history.back");
                }
                else
                {
                    var errorContent = await response.Content.ReadAsStringAsync();
                    errorMessage = $"Error: {response.StatusCode} - {errorContent}";
                    Console.WriteLine(errorMessage);
                }
            }
            catch (Exception ex)
            {
                errorMessage = $"Ocurrió un error: {ex.Message}";
                Console.WriteLine(ex.Message);
            }
            finally
            {
                _processing = false;
                StateHasChanged();
            }
        }
    }
}
