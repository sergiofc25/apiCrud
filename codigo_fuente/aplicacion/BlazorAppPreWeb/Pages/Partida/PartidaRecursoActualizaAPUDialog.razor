<MudDialog>
    <DialogContent>
        <MudForm @ref="form" Validation="@formValidation">
            @if (partidarecurso != null)
            {
                <MudGrid>
                    @if (partidarecurso.TipRec_Nombre == "Material")
                    {
                        <MudAlert Severity="Severity.Warning"> El Precio se actualizará en todos los recursos de este proyecto</MudAlert>
                        <MudItem xs="12" md="6">
                            <MudTextField @bind-Value="partidarecursoActualizar.Rec_Cantidad"
                                          Label="Cantidad"
                                          Required="true"
                                          RequiredError="La cantidad es requerida"
                                          Immediate="true" />
                        </MudItem>
                        <MudItem xs="12" md="6">
                            <MudTextField @bind-Value="partidarecursoActualizar.DRP_Precio"
                                          Label="Precio"
                                          Required="true"
                                          RequiredError="El Precio es requerido"
                                          Immediate="true" />
                        </MudItem>
                    }
                    else if ((partidarecurso.TipRec_Nombre == "Mano de Obra" || partidarecurso.TipRec_Nombre == "Equipo") & (partidarecurso.Rec_Nombre != "Herramientas manuales (%MO)"))
                    {
                        <MudAlert Severity="Severity.Warning"> El Precio se actualizará en todos los recursos de este proyecto</MudAlert>
                        <MudItem xs="12" md="6">
                            <MudTextField @bind-Value="partidarecursoActualizar.Rec_Cuadrilla"
                                          Label="Cuadrilla"
                                          Required="true"
                                          RequiredError="El cuadrilla es requerida"
                                          Immediate="true" />
                        </MudItem>
                        <MudItem xs="12" md="6">
                            <MudTextField @bind-Value="partidarecursoActualizar.DRP_Precio"
                                          Label="Precio"
                                          Required="true"
                                          RequiredError="El Precio es requerido"
                                          Immediate="true" />
                        </MudItem>
                    }
                    else if (partidarecurso.Rec_Nombre == "Herramientas manuales (%MO)")
                    {
                        <MudItem xs="12" md="6">
                            <MudTextField @bind-Value="partidarecursoActualizar.Rec_Cantidad"
                                          Label="Cantidad"
                                          Required="true"
                                          RequiredError="La cantidad es requerida"
                                          Immediate="true" />
                        </MudItem>
                    }

                </MudGrid>
            }
           
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancelar" Color="Color.Error">Cancelar</MudButton>
        <MudButton OnClick="Actualizar" Color="Color.Primary" Disabled="form == null || !form.IsValid">Actualizar</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] MudDialogInstance MudDialog { get; set; }
    [Parameter] public string DetParRec_Id { get; set; }

    private DTO_Partida_Recurso_Actualiza_APU partidarecursoActualizar = new DTO_Partida_Recurso_Actualiza_APU();
    private DTO_Partida_Recurso_Obten_x_Id_APU partidarecurso;


    private MudForm form;
    private bool formValidation = true;
    private bool actualizando = false;
    private bool _processing = false;

    private string errorMessage = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        await CargarPartidaRecurso(DetParRec_Id);
    }

