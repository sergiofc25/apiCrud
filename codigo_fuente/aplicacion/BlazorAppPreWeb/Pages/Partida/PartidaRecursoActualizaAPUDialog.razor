    private async Task CargarPartidaRecurso(string DetParRec_Id)
    {
        _processing = true;
        try
        {
            var client = ClientFactory.CreateClient("ApiPRESUPUESTOS");
            client.DefaultRequestHeaders.Authorization = new AuthenticationHeaderValue("Bearer",
                await localStorage.GetItemAsync<string>("authToken"));

            var response = await client.GetAsync($"api/v1/Partida_Recurso/Obten_x_Id_APU/{DetParRec_Id}");

            if (response.IsSuccessStatusCode)
            {
                var result = JsonConvert.DeserializeObject<DTO_Response<DTO_Partida_Recurso_Obten_x_Id_APU>>(
                    await response.Content.ReadAsStringAsync());

                partidarecurso = result?.Data ?? new DTO_Partida_Recurso_Obten_x_Id_APU();
                partidarecursoActualizar = new DTO_Partida_Recurso_Actualiza_APU
                {
                    Rec_Cantidad = result.Data.Rec_Cantidad,
                    Rec_Cuadrilla = result.Data.Rec_Cuadrilla,
                    DRP_Precio = result.Data.DRP_Precio
                };
            }
        }
        finally
        {
            _processing = false;
        }
    }

    private async Task Actualizar()
    {
        actualizando = true;
        await form.Validate();

        if (form.IsValid)
        {
            try
            {
                var client = ClientFactory.CreateClient("ApiPRESUPUESTOS");
                var token = await localStorage.GetItemAsync<string>("authToken");

                if (token != null)
                {
                    client.DefaultRequestHeaders.Authorization = new AuthenticationHeaderValue("Bearer", token);
                }

                var partidarecursoParaActualizar = new DTO_Partida_Recurso_Actualiza_APU
                    {
                        Rec_Cantidad = partidarecursoActualizar?.Rec_Cantidad,
                        Rec_Cuadrilla = partidarecursoActualizar?.Rec_Cuadrilla,
                        DRP_Precio = partidarecursoActualizar?.DRP_Precio
                    };

                var response = await client.PutAsJsonAsync($"api/v1/Partida_Recurso/Actualiza_APU/{DetParRec_Id}", partidarecursoParaActualizar);

                if (response.IsSuccessStatusCode)
                {
                    Snackbar.Add("Recurso actualizado exitosamente", Severity.Success);
                    MudDialog.Close(DialogResult.Ok(true));
                }
                else
                {
                    var errorContent = await response.Content.ReadAsStringAsync();
                    Snackbar.Add($"Error al actualizar recurso: {errorContent}", Severity.Error);
                }
            }
            catch (Exception ex)
            {
                Snackbar.Add($"Error: {ex.Message}", Severity.Error);
            }
            finally
            {
                actualizando = false;
            }
        }
        else
        {
            actualizando = false;
        }
    }

    
    private void Cancelar()
    {
        MudDialog.Cancel();
    }
