@page "/partida_actualiza/{Par_Id}"
@using Newtonsoft.Json
@using MudBlazor
@using Model.DTO.v1
@inject IHttpClientFactory ClientFactory
@inject NavigationManager NavigationManager
@using Blazored.LocalStorage
@using System.Net.Http.Headers
@using System.Text
@using System.Net
@using System.Reflection.Metadata
@inject ILocalStorageService localStorage
@using Microsoft.JSInterop
@inject IJSRuntime JSRuntime
@using System.Globalization;
@using System.Linq
@inject IDialogService DialogService


<PageTitle>Actualizar Partida</PageTitle>

<MudGrid>
    <MudItem xs="12">
        <MudPaper Class="pa-4" Elevation="3">
            <MudGrid>
                <MudItem xs="6">
                    <MudText Typo="Typo.h5" Color="Color.Primary" Class="ml-2">Partida</MudText>
                </MudItem>
                <MudItem xs="6" Class="ml-2">
                    <MudText Typo="Typo.h6" Color="Color.Primary">@(partida?.Par_Nombre ?? "N/A")</MudText>
                </MudItem>
            </MudGrid>
        </MudPaper>
    </MudItem>
    <MudItem xs="12">
        <MudPaper Class="pa-5 d-flex justify-end" Elevation="3">
            <MudSwitch T="bool"
                        @bind-Checked="disabled"
                        Color="Color.Primary"
                        Label="Editar"
                        Class="mt-2" />
         </MudPaper>
        <MudPaper Class="pa-5" Elevation="3">
            @if (partida != null)
            {
                <MudForm Model="@partida" @ref="form" OnValidSubmit="ActualizarPartida">
                    <MudTextField @bind-Value="partida.Par_Nombre" Label="Nombre" Required="true" Disabled="@disabled" Class="mud-width-full" />
                    <MudNumericField @bind-Value="partida.Par_RenManObra" Label="Rendimiento Mano de Obra" Disabled="@disabled" Required="true" Class="mud-width-full" />
                    <MudNumericField @bind-Value="partida.Par_RenEquipo" Label="Rendimiento Equipos" Disabled="@disabled" Required="true" Class="mud-width-full" />
                    <MudGrid Class="align-center" Spacing="2">
                        <MudItem xs="12" sm="8" md="8" lg="8">
                            <MudAutocomplete T="DTO_Unidad_Medida_Obten"
                                                Label="Buscar unidad medida"
                                                @bind-Value="selectedUnidadMedida"
                                                ToStringFunc="@(unid => unid?.UniMed_Nombre ?? "Seleccione unidad")"
                                                SearchFunc="@SearchUnidadMedidas"
                                                Dense="true"
                                                Disabled="@disabled"
                                                Class="mud-width-full" />
                        </MudItem>
                        <MudItem xs="12" sm="4" md="4" lg="4">
                            <MudTextField @bind-Value="selectedUnidadMedida.UniMed_Abreviatura" Variant="Variant.Filled" Disabled="true" />
                        </MudItem>
                    </MudGrid>
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small" Disabled="@disabled" EndIcon="@Icons.Material.Filled.Send" OnClick="@(async () => await ActualizarPartida())">
                        @if (_processing)
                        {
                            <MudProgressCircular Class="ms-n1" Size="Size.Small" Indeterminate="true" Color="Color.Inherit" />
                            <MudText Class="ms-2">Actualizando...</MudText>
                        }
                        else
                        {
                            <MudText>Actualizar</MudText>
                        }
                    </MudButton>
                    <MudButton @onclick="OpenDialogAsyncEliminaPartida"
                               Disabled="@disabled"
                               Variant="Variant.Filled"
                               Color="Color.Secondary">
                        Eliminar Partida
                    </MudButton>
                </MudForm>
            }
            @if (!string.IsNullOrEmpty(errorMessage))
            {
                <MudAlert Severity="Severity.Error" Variant="Variant.Filled" Class="mt-2">@errorMessage</MudAlert>
            }
        </MudPaper>
    </MudItem>
</MudGrid>

@code {
    [Parameter] public string Par_Id { get; set; }
    private DTO_Partida_Obten_x_Id partida;
    private MudForm? form;
    private List<DTO_Unidad_Medida_Obten> unidadmedidas = new List<DTO_Unidad_Medida_Obten>();
    private DTO_Unidad_Medida_Obten selectedUnidadMedida { get; set; } = new DTO_Unidad_Medida_Obten();
    private bool _processing = false;
    private string errorMessage = string.Empty;
    bool disabled = true;

    protected override async Task OnInitializedAsync()
    {
        await LoadPartida();
        await GetUnidadMedida();


    }
    private async Task LoadPartida()
    {
        _processing = true;
        try
        {
            var client = ClientFactory.CreateClient("ApiPRESUPUESTOS");
            client.DefaultRequestHeaders.Authorization = new AuthenticationHeaderValue("Bearer",
                await localStorage.GetItemAsync<string>("authToken"));

            var response = await client.GetAsync($"api/v1/Partida/Obten_x_Id/{Par_Id}");

            if (response.IsSuccessStatusCode)
            {
                var responseBody = await response.Content.ReadAsStringAsync();
                var result = JsonConvert.DeserializeObject<DTO_Response<DTO_Partida_Obten_x_Id>>(responseBody);

                partida = result?.Data ?? new DTO_Partida_Obten_x_Id();
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error: {ex.Message}";
        }
        finally
        {
            _processing = false;
            StateHasChanged();
        }
    }
    private async Task<IEnumerable<DTO_Unidad_Medida_Obten>> SearchUnidadMedidas(string searchText)
    {
        if (string.IsNullOrEmpty(searchText))
            return unidadmedidas;

        return unidadmedidas.Where(unid =>
            RemoveDiacritics(unid.UniMed_Nombre ?? "")
                .Contains(RemoveDiacritics(searchText), StringComparison.OrdinalIgnoreCase));
    }
    private static string RemoveDiacritics(string text)
    {
        if (string.IsNullOrWhiteSpace(text))
            return text;

        text = text.Normalize(NormalizationForm.FormD);
        var chars = text.Where(c => CharUnicodeInfo.GetUnicodeCategory(c) != UnicodeCategory.NonSpacingMark).ToArray();
        return new string(chars).Normalize(NormalizationForm.FormC);
    }
    private async Task GetUnidadMedida()
    {
        try
        {
            var client = ClientFactory.CreateClient("ApiPRESUPUESTOS");
            var token = await localStorage.GetItemAsync<string>("authToken");
            if (token != null)
            {
                client.DefaultRequestHeaders.Authorization = new AuthenticationHeaderValue("Bearer", token);
            }

            var response = await client.GetAsync("api/v1/Unidad_Medida/Obten");
            Console.WriteLine($"Response Status: {response.StatusCode}");

            if (response.IsSuccessStatusCode)
            {
                string responseBody = await response.Content.ReadAsStringAsync();
                Console.WriteLine($"Response Body: {responseBody}");
                var result = JsonConvert.DeserializeObject<DTO_Response<List<DTO_Unidad_Medida_Obten>>>(responseBody);

                if (result != null && result.IsSuccessful)
                {
                    unidadmedidas = result.Data;
                    selectedUnidadMedida = unidadmedidas.FirstOrDefault(unid => unid.UniMed_Nombre == partida.UniMed_Nombre);
                }
                else
                {
                    Console.WriteLine("Response not successful or no data.");
                }
            }
            else
            {
                Console.WriteLine($"Error: {response.StatusCode}");
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error al cargar unidades de medida: {ex.Message}";
            Console.WriteLine(ex.Message);
        }
        StateHasChanged();
    }
    private async Task ActualizarPartida()
    {
        if (partida == null || selectedUnidadMedida == null) return;
        
        partida.UniMed_Nombre = selectedUnidadMedida.UniMed_Nombre;

        _processing = true;
        StateHasChanged(); // Actualiza el UI para mostrar el estado de procesamiento

        try
        {
            var client = ClientFactory.CreateClient("ApiPRESUPUESTOS");
            var token = await localStorage.GetItemAsync<string>("authToken");
            if (token != null)
            {
                client.DefaultRequestHeaders.Authorization = new AuthenticationHeaderValue("Bearer", token);
            }
            var content = new StringContent(JsonConvert.SerializeObject(partida), System.Text.Encoding.UTF8, "application/json");
            var response = await client.PutAsync($"api/v1/Partida/Actualiza/{Par_Id}", content);
            if (response.IsSuccessStatusCode)
            {
                NavigationManager.NavigateTo(NavigationManager.Uri, forceLoad: true);
            }
            else
            {
                var errorContent = await response.Content.ReadAsStringAsync();
                errorMessage = $"Error: {response.StatusCode} - {errorContent}";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Ocurrió un error: {ex.Message}";
        }
        finally
        {
            _processing = false;
            StateHasChanged();
        }
    }
    private async Task EliminarPartida()
    {
        if (partida == null) return;

        _processing = true;
        StateHasChanged(); // Actualiza el UI para mostrar el estado de procesamiento

        try
        {
            // Actualiza el estado del cliente a 'False'
            partida.Par_Estado = "False";

            var client = ClientFactory.CreateClient("ApiPRESUPUESTOS");
            var token = await localStorage.GetItemAsync<string>("authToken");
            if (token != null)
            {
                client.DefaultRequestHeaders.Authorization = new AuthenticationHeaderValue("Bearer", token);
            }
            var content = new StringContent(JsonConvert.SerializeObject(partida), System.Text.Encoding.UTF8, "application/json");
            var response = await client.PutAsync($"api/v1/Partida/Inhabilita/{Par_Id}", content);
            if (response.IsSuccessStatusCode)
            {
                await JSRuntime.InvokeVoidAsync("history.back");
            }
            else
            {
                var errorContent = await response.Content.ReadAsStringAsync();
                errorMessage = $"Error: {response.StatusCode} - {errorContent}";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Ocurrió un error: {ex.Message}";
        }
        finally
        {
            _processing = false;
            StateHasChanged(); // Actualiza el UI para ocultar el estado de procesamiento
        }
    }
    private async Task OpenDialogAsyncEliminaPartida()
    {
        var options = new DialogOptions()
            {
                CloseOnEscapeKey = true,
                CloseButton = true,
                FullWidth = true
            };

        var dialog = DialogService.Show<PartidaElimina>("Inhabilitar Partida", options);
        var result = await dialog.Result;

        if (!result.Cancelled)
        {
            await EliminarPartida();
        }
    }


}