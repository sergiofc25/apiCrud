@page "/partida"
@using Newtonsoft.Json
@using MudBlazor
@using Model.DTO.v1
@inject IHttpClientFactory ClientFactory
@inject NavigationManager NavigationManager
@using Blazored.LocalStorage
@using System.Net.Http.Headers
@using System.Text
@using System.Net
@using System.Reflection.Metadata
@inject ILocalStorageService localStorage
@using Microsoft.JSInterop
@inject IJSRuntime JSRuntime
@using System.Globalization;
@using System.Linq
@inject IDialogService DialogService


<PageTitle>Actualizar Partida</PageTitle>

<MudGrid>
    <MudItem xs="12">
        <MudPaper Class="pa-4" Elevation="3">
            <MudGrid>
                <MudItem xs="6">
                    <MudText Typo="Typo.h6" Color="Color.Primary">@(partida?.Par_Nombre ?? "N/A")</MudText>
                </MudItem>
                <MudItem xs="6" Class="ml-2">
                    <MudText Typo="Typo.h5" Color="Color.Primary" Class="ml-2">Datos de Partida</MudText>
                </MudItem>
            </MudGrid>
        </MudPaper>
    </MudItem>
    <MudItem xs="12">
        <MudPaper Class="pa-5 d-flex justify-end" Elevation="3">
            <MudSwitch T="bool"
            @bind-Checked="disabled"
            Color="Color.Primary"
            Label="Editar"
            Class="mt-2" />
        </MudPaper>
        <MudPaper Class="pa-5" Elevation="3">
            @if (partida != null)
            {
                <MudForm Model="@partida" @ref="form" OnValidSubmit="ActualizarPartida">
                    <MudTextField @bind-Value="partida.Par_Nombre" Label="Nombre" Required="true" Disabled="@disabled" Class="mud-width-full" />
                    <MudNumericField @bind-Value="partida.Par_RenManObra" Label="Rendimiento Mano de Obra" Disabled="@disabled" Required="true" Class="mud-width-full" />
                    <MudNumericField @bind-Value="partida.Par_RenEquipo" Label="Rendimiento Equipos" Disabled="@disabled" Required="true" Class="mud-width-full" />
                    <MudGrid Class="align-center" Spacing="2">
                        <MudItem xs="12" sm="8" md="8" lg="8">
                            <MudAutocomplete T="DTO_Unidad_Medida_Obten"
                            Label="Buscar unidad medida"
                            @bind-Value="selectedUnidadMedida"
                            ToStringFunc="@(unid => unid?.UniMed_Nombre ?? "Seleccione unidad")"
                            SearchFunc="@SearchUnidadMedidas"
                            Dense="true"
                            Disabled="@disabled"
                            Class="mud-width-full" />
                        </MudItem>
                        <MudItem xs="12" sm="4" md="4" lg="4">
                            <MudTextField @bind-Value="selectedUnidadMedida.UniMed_Abreviatura" Variant="Variant.Filled" Disabled="true" />
                        </MudItem>
                    </MudGrid>
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small" Disabled="@disabled" EndIcon="@Icons.Material.Filled.Send" OnClick="@(async () => await ActualizarPartida())">
                        @if (_processing)
                        {
                            <MudProgressCircular Class="ms-n1" Size="Size.Small" Indeterminate="true" Color="Color.Inherit" />
                            <MudText Class="ms-2">Actualizando...</MudText>
                        }
                        else
                        {
                            <MudText>Actualizar</MudText>
                        }
                    </MudButton>
                    <MudButton @onclick="OpenDialogAsyncEliminaPartida"
                    Disabled="@disabled"
                    Variant="Variant.Filled"
                    Color="Color.Secondary">
                        Eliminar Partida
                    </MudButton>
                </MudForm>
            }
            @if (!string.IsNullOrEmpty(errorMessage))
            {
                <MudAlert Severity="Severity.Error" Variant="Variant.Filled" Class="mt-2">@errorMessage</MudAlert>
            }
        </MudPaper>
    </MudItem>
    <MudItem xs="12">
        <MudPaper Class="pa-4" Elevation="3">
            <MudItem xs="6">
                <MudText Typo="Typo.h5" Color="Color.Primary" Class="ml-2">Análisis de Costos</MudText>
            </MudItem>
        </MudPaper>
    </MudItem>
    <MudItem xs="12">
        <MudPaper Class="pa-4" Elevation="3">
            @if (partida != null)
            {
                <MudText Typo="Typo.h6" Color="Color.Primary">Precio Unitario de partida @(partida.Par_PreUnitario)</MudText>
            }
        </MudPaper>
    </MudItem>
    <MudItem xs="12">
        <MudPaper Class="pa-5" Elevation="3">
            <MudButton onclick="@(() => NavigateToRecursoAsignaRecurso(Par_Id))"
            Variant="Variant.Filled"
            Color="Color.Primary">
                Asignar Recurso
            </MudButton>
        </MudPaper>
        <MudPaper Class="p-4" Elevation="4" Style="border-radius:12px;">
            <MudTable Items="@recursos" GroupIndent="0" Hover="true" Breakpoint="Breakpoint.Sm" Height="500px" FixedHeader="true" GroupBy="@_groupDefinition" Dense="false" Striped="true" Class="elevation-2 rounded-lg">
                <HeaderContent>
                    <MudTh Class="text-center font-weight-bold">Índice Unificado</MudTh>
                    <MudTh Class="text-center font-weight-bold">Nombre</MudTh>
                    <MudTh Class="text-center font-weight-bold">Unidad</MudTh>
                    <MudTh Class="text-center font-weight-bold">Cuadrilla</MudTh>
                    <MudTh Class="text-center font-weight-bold">Cantidad</MudTh>
                    <MudTh Class="text-center font-weight-bold">Precio</MudTh>
                    <MudTh Class="text-center font-weight-bold">Parcial</MudTh>
                    <MudTh Class="text-center font-weight-bold">Acciones</MudTh>
                </HeaderContent>
                <GroupHeaderTemplate>
                    <MudTr>
                        <!-- Usamos MudTh para que abarque todo y se centre correctamente -->
                        <MudTh ColSpan="8" Class="text-center font-weight-bold">@context.Key</MudTh>
                    </MudTr>
                </GroupHeaderTemplate>
                <RowTemplate>
                    <MudTd DataLabel="Índice Unificado" Class="text-center">@context.Rec_IndUnificado</MudTd>
                    <MudTd DataLabel="Nombre">@context.Rec_Nombre</MudTd>
                    <MudTd DataLabel="Unidad" Class="text-center">@context.UniMed_Abreviatura</MudTd>
                    <MudTd DataLabel="Cuadrilla" Class="text-center">@context.Rec_Cuadrilla</MudTd>
                    <MudTd DataLabel="Cantidad" Class="text-end">@context.Rec_Cantidad</MudTd>
                    <MudTd DataLabel="Precio" Class="text-end">@(context.Rec_Nombre == "Herramientas manuales (%MO)" ? context.DetParRec_Precio_HM : context.DRP_Precio)</MudTd>
                    <MudTd DataLabel="Parcial" Class="text-end">@context.DetParRec_PrecioUnitario</MudTd>
                    <MudTd DataLabel="Acciones" Class="text-center">
                    <MudIconButton 
                        Icon="@Icons.Material.Filled.Edit" 
                        Variant="Variant.Filled" 
                        Color="Color.Primary" 
                        Size="Size.Small"
                        Class="me-1" 
                        @onclick="@(() => Btn_Actualizar_Partida_Recurso_APU_Click(@context.DetParRec_Id))" />
                    <MudIconButton Icon="@Icons.Material.Filled.Delete" Variant="Variant.Filled" Color="Color.Error" Size="Size.Small" @onclick="() => OpenDeleteDialog(context.DetParRec_Id)" />
                    </MudTd>
                </RowTemplate>
                <GroupFooterTemplate>
                    <MudTr>
                    <MudTd ColSpan="8"><MudDivider Class="my-2" /></MudTd>
                    </MudTr>
                </GroupFooterTemplate>
                <NoRecordsContent>
                    <MudText Class="text-secondary">No se encontraron registros.</MudText>
                </NoRecordsContent>
                <LoadingContent>
                    <MudText Class="text-info">Un momento por favor...</MudText>
                </LoadingContent>
                </MudTable>
        </MudPaper>

    </MudItem>
</MudGrid>
<style>
    .mud-table-cell-custom-group {
    font-weight: 500;
    background-color: var(--mud-palette-background-grey);
    }

    .mud-table-cell-custom-group-footer {
    padding-bottom: 16px;
    text-align: right;
    }
</style>
@code {
    [Parameter] public string Par_Id { get; set; }
    private DTO_Partida_Obten_x_Id partida;
    private MudForm? form;
    private List<DTO_Unidad_Medida_Obten> unidadmedidas = new List<DTO_Unidad_Medida_Obten>();
    private DTO_Unidad_Medida_Obten selectedUnidadMedida { get; set; } = new DTO_Unidad_Medida_Obten();
    private IEnumerable<DTO_Recurso_Obten_x_Partida> recursos = new List<DTO_Recurso_Obten_x_Partida>();


    private bool _processing = false;
    private string errorMessage = string.Empty;
    bool disabled = true;


    protected override async Task OnInitializedAsync()
    {
        Par_Id = NavigationManager.HistoryEntryState?.ToString();

        if (string.IsNullOrEmpty(Par_Id))
        {
            Par_Id = await localStorage.GetItemAsync<string>("currentPartidaId");
        }
        await LoadRecursos();
        await GetUnidadMedida();

        if (!string.IsNullOrEmpty(Par_Id))
        {
            await LoadPartida(Par_Id);
        }
        else
        {
            NavigationManager.NavigateTo("/partida"); // Redirige si no hay ID  
        }

    }
    private TableGroupDefinition<DTO_Recurso_Obten_x_Partida> _groupDefinition = new()
        {
            GroupName = "Tipo de Recurso",
            Indentation = false,
            Expandable = true,
            Selector = (e) => e.TipRec_Nombre
        };

    private async Task LoadPartida(string Par_Id)
    {
        _processing = true;
        try
        {
            var client = ClientFactory.CreateClient("ApiPRESUPUESTOS");
            client.DefaultRequestHeaders.Authorization = new AuthenticationHeaderValue("Bearer",
                await localStorage.GetItemAsync<string>("authToken"));

            var response = await client.GetAsync($"api/v1/Partida/Obten_x_Id/{Par_Id}");

            if (response.IsSuccessStatusCode)
            {
                var result = JsonConvert.DeserializeObject<DTO_Response<DTO_Partida_Obten_x_Id>>(
                    await response.Content.ReadAsStringAsync());

                partida = result?.Data ?? new DTO_Partida_Obten_x_Id();

                // Asignar unidad de medida DESPUÉS de cargar partida
                if (partida != null && !string.IsNullOrEmpty(partida.UniMed_Nombre))
                {
                    selectedUnidadMedida = unidadmedidas.FirstOrDefault(u =>
                        u.UniMed_Nombre == partida.UniMed_Nombre) ?? new DTO_Unidad_Medida_Obten();
                }
            }
        }
        finally
        {
            _processing = false;
        }
    }
    private async Task<IEnumerable<DTO_Unidad_Medida_Obten>> SearchUnidadMedidas(string searchText)
    {
        if (string.IsNullOrEmpty(searchText))
            return unidadmedidas;

        return unidadmedidas.Where(unid =>
            RemoveDiacritics(unid.UniMed_Nombre ?? "")
                .Contains(RemoveDiacritics(searchText), StringComparison.OrdinalIgnoreCase));
    }
    private static string RemoveDiacritics(string text)
    {
        if (string.IsNullOrWhiteSpace(text))
            return text;

        text = text.Normalize(NormalizationForm.FormD);
        var chars = text.Where(c => CharUnicodeInfo.GetUnicodeCategory(c) != UnicodeCategory.NonSpacingMark).ToArray();
        return new string(chars).Normalize(NormalizationForm.FormC);
    }
    private async Task GetUnidadMedida()
    {
        try
        {
            var client = ClientFactory.CreateClient("ApiPRESUPUESTOS");
            var token = await localStorage.GetItemAsync<string>("authToken");
            client.DefaultRequestHeaders.Authorization = new AuthenticationHeaderValue("Bearer", token);

            var response = await client.GetAsync("api/v1/Unidad_Medida/Obten");

            if (response.IsSuccessStatusCode)
            {
                var responseBody = await response.Content.ReadAsStringAsync();
                var result = JsonConvert.DeserializeObject<DTO_Response<List<DTO_Unidad_Medida_Obten>>>(responseBody);

                if (result?.IsSuccessful == true)
                {
                    unidadmedidas = result.Data;
                }
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error al cargar unidades: {ex.Message}";
        }
    }
    private async Task ActualizarPartida()
    {
        if (partida == null || selectedUnidadMedida == null) return;

        partida.UniMed_Nombre = selectedUnidadMedida.UniMed_Nombre;

        _processing = true;
        StateHasChanged(); // Actualiza el UI para mostrar el estado de procesamiento

        try
        {
            var client = ClientFactory.CreateClient("ApiPRESUPUESTOS");
            var token = await localStorage.GetItemAsync<string>("authToken");
            if (token != null)
            {
                client.DefaultRequestHeaders.Authorization = new AuthenticationHeaderValue("Bearer", token);
            }
            var content = new StringContent(JsonConvert.SerializeObject(partida), System.Text.Encoding.UTF8, "application/json");
            var response = await client.PutAsync($"api/v1/Partida/Actualiza/{Par_Id}", content);
            if (response.IsSuccessStatusCode)
            {
                //NavigationManager.NavigateTo(NavigationManager.Uri, forceLoad: true);
                await LoadPartida(Par_Id);
                await LoadRecursos();
            }
            else
            {
                var errorContent = await response.Content.ReadAsStringAsync();
                errorMessage = $"Error: {response.StatusCode} - {errorContent}";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Ocurrió un error: {ex.Message}";
        }
        finally
        {
            _processing = false;
            StateHasChanged();
        }
    }
    private async Task EliminarPartida()
    {
        if (partida == null) return;

        _processing = true;
        StateHasChanged(); // Actualiza el UI para mostrar el estado de procesamiento

        try
        {
            // Actualiza el estado del cliente a 'False'
            partida.Par_Estado = "False";

            var client = ClientFactory.CreateClient("ApiPRESUPUESTOS");
            var token = await localStorage.GetItemAsync<string>("authToken");
            if (token != null)
            {
                client.DefaultRequestHeaders.Authorization = new AuthenticationHeaderValue("Bearer", token);
            }
            var content = new StringContent(JsonConvert.SerializeObject(partida), System.Text.Encoding.UTF8, "application/json");
            var response = await client.PutAsync($"api/v1/Partida/Inhabilita/{Par_Id}", content);
            if (response.IsSuccessStatusCode)
            {
                await JSRuntime.InvokeVoidAsync("history.back");
            }
            else
            {
                var errorContent = await response.Content.ReadAsStringAsync();
                errorMessage = $"Error: {response.StatusCode} - {errorContent}";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Ocurrió un error: {ex.Message}";
        }
        finally
        {
            _processing = false;
            StateHasChanged(); // Actualiza el UI para ocultar el estado de procesamiento
        }
    }
    private async Task OpenDialogAsyncEliminaPartida()
    {
        var options = new DialogOptions()
            {
                CloseOnEscapeKey = true,
                CloseButton = true,
                FullWidth = true
            };

        var dialog = DialogService.Show<PartidaElimina>("Inhabilitar Partida", options);
        var result = await dialog.Result;

        if (!result.Cancelled)
        {
            await EliminarPartida();
        }
    }
    private async Task LoadRecursos()
    {
        _processing = true;
        try
        {
            var client = ClientFactory.CreateClient("ApiPRESUPUESTOS");
            client.DefaultRequestHeaders.Authorization = new AuthenticationHeaderValue("Bearer",
                await localStorage.GetItemAsync<string>("authToken"));

            var response = await client.GetAsync($"api/v1/Recurso/Obten_x_Partida/{Par_Id}");

            if (response.IsSuccessStatusCode)
            {
                var responseBody = await response.Content.ReadAsStringAsync();
                var result = JsonConvert.DeserializeObject<DTO_Response<List<DTO_Recurso_Obten_x_Partida>>>(responseBody);

                recursos = result?.Data ?? new List<DTO_Recurso_Obten_x_Partida>();
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error: {ex.Message}";
        }
        finally
        {
            _processing = false;
            StateHasChanged();
        }
    }
    private async Task OpenDeleteDialog(string DetParRec_Id)
    {
        var parameters = new DialogParameters
        {
            { "DetParRec_Id", DetParRec_Id }
        };

        var options = new DialogOptions
            {
                CloseButton = true,
                MaxWidth = MaxWidth.ExtraSmall,
                FullWidth = true
            };

        var dialog = DialogService.Show<PartidaRecursoEliminaAPU>("Confirmar Eliminación", parameters, options);
        var result = await dialog.Result;

        if (!result.Cancelled && (bool)result.Data)
        {
            await LoadRecursos();
            await LoadPartida(Par_Id);
        }
    }
    private async Task Btn_Actualizar_Partida_Recurso_APU_Click(string DetParRec_Id)
    {
        var options = new DialogOptions()
            {
                CloseOnEscapeKey = true,
                CloseButton = true,
                FullWidth = true,
                MaxWidth = MaxWidth.Small
            };

        var parameters = new DialogParameters();
        parameters.Add("DetParRec_Id", DetParRec_Id);

        var dialog = DialogService.Show<PartidaRecursoActualizaAPUDialog>("Actualizar Valores", parameters, options);
        var result = await dialog.Result;

        if (!result.Cancelled)
        {
            await LoadRecursos();
            await LoadPartida(Par_Id);
        }
    }
    private async Task NavigateToRecursoAsignaRecurso(string Par_Id)
    {
        try
        {
            // Guardar el Par_Id en localStorage antes de navegar
            await localStorage.SetItemAsync("currentPartidaId", Par_Id);

            // Redirigir a la nueva página
            NavigationManager.NavigateTo($"/recurso_asigna_precio");
        }
        catch (Exception ex)
        {
            // Manejar errores (opcional)
            Console.WriteLine($"Error al navegar: {ex.Message}");
        }
    }
}