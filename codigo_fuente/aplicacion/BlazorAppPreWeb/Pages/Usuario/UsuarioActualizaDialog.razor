@using Model.DTO.v1
@using MudBlazor
@using System.Net.Http.Headers
@inject IHttpClientFactory ClientFactory
@using Blazored.LocalStorage
@inject ILocalStorageService localStorage
@inject ISnackbar Snackbar
@inject NavigationManager NavigationManager
@using Newtonsoft.Json
@using Microsoft.JSInterop
@using System.Globalization
@using System.Linq
@using System.Text

<MudDialog>
    <DialogContent>
        <MudForm @ref="form" Validation="@formValidation">
            <MudGrid>
                <MudItem xs="12" md="6">
                    <MudTextField @bind-Value="usuarioActualizar.Usu_Correo"
                                  Label="Usuario"
                                  Required="true"
                                  RequiredError="El Usuario es requerido"
                                  Immediate="true" />
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudTextField @bind-Value="usuarioActualizar.Usu_NomApellidos"
                                  Label="Nombres"
                                  Required="true"
                                  RequiredError="El Nombre es requerido"
                                  Immediate="true" />
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudSelect T="DTO_Rol_Obten"
                               Label="Roles"
                               @bind-Value="selectedRol"
                               ToStringFunc="@(r => r?.Rol_Nombre ?? "Seleccione Rol")"
                               Dense="true"
                               Class="mud-width-full">
                        @foreach (var rol in roles)
                        {
                            <MudSelectItem Value="@rol">@rol.Rol_Nombre</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudTextField @bind-Value="usuarioActualizar.Usu_Clave"
                                  Label="Contraseña"
                                  Immediate="true"
                                  Adornment="Adornment.End"
                                  AdornmentIcon="@(showPassword ? Icons.Material.Filled.Visibility : Icons.Material.Filled.VisibilityOff)"
                                  AdornmentColor="Color.Primary"
                                  OnAdornmentClick="@(() => showPassword = !showPassword)"
                                  InputIcon="@Icons.Material.Filled.Lock"
                                  InputType="@(showPassword ? InputType.Text : InputType.Password)" />
                </MudItem>
                <MudItem xs="20" md="12">
                    <MudTextField @bind-Value="usuarioActualizar.Usu_Observacion"
                                  Label="Observación"
                                  Immediate="true" />
                </MudItem>
            </MudGrid>
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancelar" Color="Color.Error">Cancelar</MudButton>
        <MudButton OnClick="Actualizar" Color="Color.Primary" Disabled="form == null || !form.IsValid">Actualizar</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] MudDialogInstance MudDialog { get; set; }
    [Parameter] public string Usu_Id { get; set; }

    private DTO_Usuario_Actualiza usuarioActualizar = new DTO_Usuario_Actualiza();
    private List<DTO_Rol_Obten> roles = new List<DTO_Rol_Obten>();
    private DTO_Rol_Obten selectedRol { get; set; } = new DTO_Rol_Obten();
    private DTO_Usuario_Obten_x_Id usuario;


    private MudForm form;
    private bool formValidation = true;
    private bool actualizando = false;
    private string errorMessage = string.Empty;
    private bool _processing = false;

    private bool showPassword = false;


    protected override async Task OnInitializedAsync()
    {
        await GetRol();
        await CargarUsuario(Usu_Id);
    }

    private async Task CargarUsuario(string Usu_Id)
    {
        _processing = true;
        try
        {
            var client = ClientFactory.CreateClient("ApiPRESUPUESTOS");
            client.DefaultRequestHeaders.Authorization = new AuthenticationHeaderValue("Bearer",
                await localStorage.GetItemAsync<string>("authToken"));

            var response = await client.GetAsync($"api/v1/Usuario/Obten_x_Id/{Usu_Id}");

            if (response.IsSuccessStatusCode)
            {
                var result = JsonConvert.DeserializeObject<DTO_Response<DTO_Usuario_Obten_x_Id>>(
                    await response.Content.ReadAsStringAsync());

                usuario = result?.Data ?? new DTO_Usuario_Obten_x_Id();
                usuarioActualizar = new DTO_Usuario_Actualiza
                {
                    Usu_Correo = result.Data.Usu_Correo,
                    Usu_NomApellidos = result.Data.Usu_NomApellidos,
                };
                selectedRol = roles.FirstOrDefault(r => r.Rol_Nombre == result.Data.Rol_Nombre);
            }
        }
        finally
        {
            _processing = false;
        }
    }
    private async Task GetRol()
    {
        try
        {
            var client = ClientFactory.CreateClient("ApiPRESUPUESTOS");
            var token = await localStorage.GetItemAsync<string>("authToken");
            if (token != null)
            {
                client.DefaultRequestHeaders.Authorization = new AuthenticationHeaderValue("Bearer", token);
            }

            var response = await client.GetAsync("api/v1/Rol/Obten");
            Console.WriteLine($"Response Status: {response.StatusCode}");

            if (response.IsSuccessStatusCode)
            {
                string responseBody = await response.Content.ReadAsStringAsync();
                Console.WriteLine($"Response Body: {responseBody}");
                var result = JsonConvert.DeserializeObject<DTO_Response<List<DTO_Rol_Obten>>>(responseBody);

                if (result != null && result.IsSuccessful)
                {
                    roles = result.Data;
                    Console.WriteLine($"Roles Count: {roles.Count}");
                }
                else
                {
                    Console.WriteLine("Response not successful or no data.");
                }
            }
            else
            {
                Console.WriteLine($"Error: {response.StatusCode}");
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error al cargar tipos de roles: {ex.Message}";
            Console.WriteLine(ex.Message);
        }
        StateHasChanged();
    }
    private async Task Actualizar()
    {
        actualizando = true;
        await form.Validate();

        if (form.IsValid)
        {
            try
            {
                var client = ClientFactory.CreateClient("ApiPRESUPUESTOS");
                var token = await localStorage.GetItemAsync<string>("authToken");

                if (token != null)
                {
                    client.DefaultRequestHeaders.Authorization = new AuthenticationHeaderValue("Bearer", token);
                }

                var usuarioParaActualizar = new DTO_Usuario_Actualiza
                    {
                        Usu_Correo = usuarioActualizar.Usu_Correo,
                        Usu_NomApellidos = usuarioActualizar.Usu_NomApellidos,
                        Usu_Clave = usuarioActualizar?.Usu_Clave,
                        Rol_Nombre = selectedRol.Rol_Nombre,
                        Usu_Observacion = usuarioActualizar?.Usu_Observacion
                    };

                var response = await client.PutAsJsonAsync($"api/v1/Usuario/Actualiza/{Usu_Id}", usuarioParaActualizar);

                if (response.IsSuccessStatusCode)
                {
                    Snackbar.Add("Usuario actualizado exitosamente", Severity.Success);
                    MudDialog.Close(DialogResult.Ok(true));
                }
                else
                {
                    var errorContent = await response.Content.ReadAsStringAsync();
                    Snackbar.Add($"Error al actualizar usuario: {errorContent}", Severity.Error);
                }
            }
            catch (Exception ex)
            {
                Snackbar.Add($"Error: {ex.Message}", Severity.Error);
            }
            finally
            {
                actualizando = false;
            }
        }
        else
        {
            actualizando = false;
        }
    }    
    
    private void Cancelar()
    {
        MudDialog.Cancel();
    }
}