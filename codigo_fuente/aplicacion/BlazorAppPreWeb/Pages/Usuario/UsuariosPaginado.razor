@page "/usuarios"
@using System.Net.Http.Json
@using System.Text.Json
@using MudBlazor
@using Model.DTO.v1
@inject IHttpClientFactory ClientFactory
@inject NavigationManager NavigationManager
@using Blazored.LocalStorage
@using System.Net.Http.Headers
@using System.Text
@using System.Net
@using System.Reflection.Metadata
@inject ILocalStorageService localStorage
@using Microsoft.JSInterop
@inject IJSRuntime JSRuntime
@using System.Globalization;
@using System.Linq
@inject IDialogService DialogService
@inject UserStateService UserStateService


<PageTitle>Usuarios</PageTitle>

<MudGrid>
    <MudItem xs="12">
        <MudPaper Class="pa-5" Elevation="3">
            <MudItem Class="d-flex align-center justify-center mud-width-full" xs="12">
                <MudItem Class="d-flex align-center justify-start mud-width-full" xs="6">
                    <MudText Typo="Typo.h6" Color="Color.Primary">Usuarios</MudText>
                </MudItem>

                <MudItem Class="d-flex align-center justify-end mud-width-full" xs="6">
                    <MudButton Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.AddBox" Color="Color.Primary"
                    Size="Size.Small" @onclick="@(() => Btn_Nuevo_Usuario_Click())">NUEVO</MudButton>
                </MudItem>
            </MudItem>
        </MudPaper>
    </MudItem>

    <MudItem xs="12">
        <MudPaper Class="pa-5" Elevation="3">
            <MudTable Items="@usuarios" RowsPerPage="@registroPagina" FixedHeader="true" Dense="true"
            Hover="true" Striped="true" Breakpoint="Breakpoint.Sm" Loading="@cargando"
            LoadingProgressColor="Color.Primary" Height="466px" Elevation="3">
                <ToolBarContent>
                    <MudText Typo="Typo.h6">Listado de Usuarios</MudText>
                </ToolBarContent>
                <ToolBarContent>
                    <MudItem Class="d-flex align-center justify-center mud-width-full pb-5" xs="12">
                        <MudTextField T="string" Value="@searchTerm" ValueChanged="@(value => OnSearch(value))"
                        Placeholder="Buscar por Usuario o Nombres" Adornment="Adornment.Start"
                        AdornmentIcon="@Icons.Material.Filled.Search" IconSize="Size.Medium" Class="mt-0">
                        </MudTextField>
                    </MudItem>
                </ToolBarContent>
                <HeaderContent>

                    <MudTh>Usuario</MudTh>
                    <MudTh>Nombres</MudTh>
                    <MudTh>Rol</MudTh>
                    <MudTh>Fecha Registro</MudTh>
                    <MudTh>Observación</MudTh>
                    <MudTh>Acciones</MudTh>
                </HeaderContent>
                <RowTemplate>

                    <MudTd DataLabel="Usuario">@context.Usu_Correo</MudTd>
                    <MudTd DataLabel="Nombres">@context.Usu_NomApellidos</MudTd>
                    <MudTd DataLabel="Rol">@context.Rol_Nombre</MudTd>
                    <MudTd DataLabel="Fecha Registro">@context.Usu_FecHoraRegistro</MudTd>
                    <MudTd DataLabel="Observación">@context.Usu_Observacion</MudTd>
                    @if(@context.Rol_Nombre != "SU")
                    {
                        <MudTd DataLabel="Acciones">
                            <MudIconButton Icon="@Icons.Material.Filled.Edit" 
                            Variant="Variant.Filled" 
                            Color="Color.Primary" 
                            Size="Size.Small" 
                            Title="Editar Usuario"
                            @onclick="@(() => Btn_Actualizar_Usuario_Click(@context.Usu_Id))">
                            </MudIconButton>
                            
                            @if (UserStateService.CurrentUser.Rol_Nombre == "SU")
                            {
                                <MudIconButton Icon="@Icons.Material.Filled.Delete"

                                               @onclick="@(() => OpenDialogAsyncEliminaRecurso(context))"
                                                Variant="Variant.Filled"
                                                Color="Color.Error"
                                                Disabled="@(context.Usu_Estado == "False")"
                                                Title="Eliminar Usuario">
                                </MudIconButton>
                            }
                        
                        </MudTd>
                    }
                </RowTemplate>
                <PagerContent>
                    <div class="d-flex flex-column align-center">
                        <MudPagination Size="Size.Small" Rectangular="true" Variant="Variant.Text" BoundaryCount="1"
                                       MiddleCount="3" Count="@metaData.TotalPagina" SelectedChanged="PageChanged" Class="pa-4" />
                    </div>
                </PagerContent>
                <NoRecordsContent>
                    <MudText>No se encontraron registros.</MudText>
                </NoRecordsContent>
                <LoadingContent>
                    <MudText>Un momento por favor...</MudText>
                </LoadingContent>
            </MudTable>
        </MudPaper>
    </MudItem>
</MudGrid>

@code {
    private IEnumerable<DTO_Usuario_Obten_Paginado> usuarios;
    private MetaData metaData = new MetaData();
    private int registroPagina = 10;
    private int numeroPagina = 1;
    private string searchTerm = string.Empty;
    private bool cargando = true;
    private string errorMessage = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        var token = await localStorage.GetItemAsync<string>("authToken");
        if (string.IsNullOrEmpty(token))
        {
            NavigationManager.NavigateTo("/login");
            return;
        }
        await LoadUsuarios();
    }

    private async Task LoadUsuarios()
    {
        try
        {
            cargando = true;
            var client = ClientFactory.CreateClient("ApiPRESUPUESTOS");

            var token = await localStorage.GetItemAsync<string>("authToken");
            if (token != null)
            {
                client.DefaultRequestHeaders.Authorization = new AuthenticationHeaderValue("Bearer", token);
            }
            var requestUri = $"api/v1/Usuario/Obten_Paginado/{registroPagina}/{numeroPagina}";

            if (!string.IsNullOrWhiteSpace(searchTerm))
            {
                requestUri += $"?PorCorreo={Uri.EscapeDataString(searchTerm)}";
            }

            var response = await client.GetAsync(requestUri);

            if (response.IsSuccessStatusCode)
            {
                var metadataHeader = response.Headers.GetValues("X-Pagination").FirstOrDefault();
                if (metadataHeader != null)
                {
                    metaData = JsonSerializer.Deserialize<MetaData>(metadataHeader);
                }

                var responseBody = await response.Content.ReadFromJsonAsync<DTO_ResponsePag<IEnumerable<DTO_Usuario_Obten_Paginado>>>();
                if (responseBody != null && responseBody.IsSuccessful)
                {
                    usuarios = responseBody.Data;
                }
            }
            else
            {
                Console.WriteLine($"Error: {response.StatusCode}");
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine(ex.Message);
        }
        finally
        {
            cargando = false;
            StateHasChanged();
        }
    }

    private void PageChanged(int page)
    {
        numeroPagina = page;
        _ = LoadUsuarios();
    }

    private void OnSearch(string searchTerm)
    {
        this.searchTerm = searchTerm;
        numeroPagina = 1;
        _ = LoadUsuarios();
    }
    private async Task EliminarRecurso(DTO_Usuario_Obten_Paginado usuario)
    {
        if (usuario == null) return;

        cargando = true;
        StateHasChanged();

        try
        {
            var client = ClientFactory.CreateClient("ApiPRESUPUESTOS");
            var token = await localStorage.GetItemAsync<string>("authToken");

            if (token != null)
            {
                client.DefaultRequestHeaders.Authorization = new AuthenticationHeaderValue("Bearer", token);
            }

            var requestData = new { Usu_Id = usuario.Usu_Id, Usu_Estado = "False" };
            var content = new StringContent(JsonSerializer.Serialize(requestData), Encoding.UTF8, "application/json");

            var response = await client.PutAsync($"api/v1/Usuario/Actualiza_Condicion/{usuario.Usu_Id}", content);

            if (response.IsSuccessStatusCode)
            {
                await LoadUsuarios();
            }
            else
            {
                var errorContent = await response.Content.ReadAsStringAsync();
                errorMessage = $"Error: {response.StatusCode} - {errorContent}";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Ocurrió un error: {ex.Message}";
        }
        finally
        {
            cargando = false;
            StateHasChanged();
        }
    }

    private async Task OpenDialogAsyncEliminaRecurso(DTO_Usuario_Obten_Paginado usuario)
    {
        var options = new DialogOptions()
            {
                CloseOnEscapeKey = true,
                CloseButton = true,
                FullWidth = true
            };

        var parameters = new DialogParameters();
        parameters.Add("Usuario", usuario);

        var dialog = DialogService.Show<UsuarioEliminaDialog>("Deshabilitar Usuario", parameters, options);
        var result = await dialog.Result;

        if (!result.Cancelled && result.Data is bool confirmado && confirmado)
        {
            await EliminarRecurso(usuario);
        }
    }
    private async Task Btn_Nuevo_Usuario_Click()
    {
        var options = new DialogOptions()
            {
                CloseOnEscapeKey = true,
                CloseButton = true,
                FullWidth = true,
                MaxWidth = MaxWidth.Small
            };

        var dialog = DialogService.Show<UsuarioCreaDialog>("Crear Nuevo Usuario", options);
        var result = await dialog.Result;

        if (!result.Cancelled)
        {
            await LoadUsuarios();
        }
    }

    private async Task Btn_Actualizar_Usuario_Click(string Usu_Id)
    {
        var options = new DialogOptions()
            {
                CloseOnEscapeKey = true,
                CloseButton = true,
                FullWidth = true,
                MaxWidth = MaxWidth.Small
            };

        var parameters = new DialogParameters();
        parameters.Add("Usu_Id", Usu_Id);

        var dialog = DialogService.Show<UsuarioActualizaDialog>("Actualizar Usuario", parameters, options);
        var result = await dialog.Result;

        if (!result.Cancelled)
        {
            await LoadUsuarios();
        }
    }
}
