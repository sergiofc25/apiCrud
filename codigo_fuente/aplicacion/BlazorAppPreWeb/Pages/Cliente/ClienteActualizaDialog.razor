@using Newtonsoft.Json
@using MudBlazor
@using Model.DTO.v1
@inject IHttpClientFactory ClientFactory
@inject NavigationManager NavigationManager
@using Blazored.LocalStorage
@using System.Net.Http.Headers
@inject ILocalStorageService localStorage

@inject IDialogService DialogService

<MudDialog>
    <DialogContent>
        @if (cliente != null)
        {
            <MudForm @ref="form" Validation="@formValidation">
                <MudGrid>
                    <MudGrid Class="align-center" Spacing="2">
                        <MudItem xs="12" sm="8" md="8" lg="8">
                            <MudTextField @bind-Value="cliente.Cli_NomApeRazSocial"
                                          Label="Nombre"
                                          Required="true"
                                          RequiredError="El Nombre es requerido"
                                          Immediate="true" />
                        </MudItem>
                        <MudItem xs="12" sm="8" md="8" lg="8">
                            <MudTextField @bind-Value="cliente.Cli_Abreviatura"
                                          Label="Abreviatura"
                                          Required="true"
                                          RequiredError="La abreviatura es Requerida"
                                          Immediate="true" />
                        </MudItem>
                        <MudItem xs="12" sm="8" md="8" lg="8">
                            <MudSelect T="DTO_Tipo_Documento_Obten" Label="Tipo de Documento"
                                       @bind-Value="selectedDocumento"
                                       ToStringFunc="@(doc => doc?.TipDoc_Nombre ?? "Seleccione tipo de documento")"
                                       Dense="true" Class="mud-width-full">
                                @foreach (var documento in documentos)
                                {
                                    <MudSelectItem Value="@documento">@documento.TipDoc_Nombre</MudSelectItem>
                                }
                            </MudSelect>
                        </MudItem>
                        <MudItem xs="12" sm="8" md="8" lg="8">
                            <MudTextField @bind-Value="cliente.Cli_NumDocumento"
                                          Label="Número de Documento"
                                          Required="true"
                                          Class="mud-width-full"
                                          InputType="InputType.Number"
                                          MaxLength="@(selectedDocumento?.TipDoc_Nombre == "DNI" ? 8 : 11)"
                                          Pattern="[0-9]*"
                                          OnInput="@((ChangeEventArgs e) => ValidateDocumentLength(e))"
                                          Immediate="true" />
                        </MudItem>
                    </MudGrid>

                </MudGrid>
            </MudForm>
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancelar" Color="Color.Error">Cancelar</MudButton>
        <MudButton OnClick="Guardar" Color="Color.Primary" Disabled="form == null || !form.IsValid">Guardar</MudButton>
    </DialogActions>
</MudDialog>


@code {
    [CascadingParameter] MudDialogInstance MudDialog { get; set; }
    [Parameter] public string Cli_Id { get; set; }
    private DTO_Cliente_Obten_x_Id cliente;
    private MudForm? form;
    private List<DTO_Tipo_Documento_Obten> documentos = new List<DTO_Tipo_Documento_Obten>();
    private DTO_Tipo_Documento_Obten selectedDocumento { get; set; } = new DTO_Tipo_Documento_Obten();
    
    private string errorMessage = string.Empty;
    private bool _processing = false;

    private bool formValidation = true;
    private bool guardando = false;

    protected override async Task OnInitializedAsync()
    {
        await LoadCliente();
        await GetDocumento();
    }

    private async Task LoadCliente()
    {
        try
        {
            var client = ClientFactory.CreateClient("ApiPRESUPUESTOS");
            var token = await localStorage.GetItemAsync<string>("authToken");
            if (token != null)
            {
                client.DefaultRequestHeaders.Authorization = new AuthenticationHeaderValue("Bearer", token);
            }
            var response = await client.GetAsync($"api/v1/Cliente/Obten_x_Id/{Cli_Id}");
            if (response.IsSuccessStatusCode)
            {
                var responseBody = await response.Content.ReadFromJsonAsync<DTO_Response<DTO_Cliente_Obten_x_Id>>();
                if (responseBody != null && responseBody.Data != null)
                {
                    cliente = responseBody.Data;
                }
                else
                {
                    errorMessage = "Cliente no encontrado.";
                }
            }
            else
            {
                var errorContent = await response.Content.ReadAsStringAsync();
                errorMessage = $"Error: {response.StatusCode} - {errorContent}";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Ocurrió un error: {ex.Message}";
        }
    }

    private async Task GetDocumento()
    {
        try
        {
            var client = ClientFactory.CreateClient("ApiPRESUPUESTOS");
            var token = await localStorage.GetItemAsync<string>("authToken");
            if (token != null)
            {
                client.DefaultRequestHeaders.Authorization = new AuthenticationHeaderValue("Bearer", token);
            }

            var response = await client.GetAsync("api/v1/Tipo_Documento/Obten");
            Console.WriteLine($"Response Status: {response.StatusCode}");

            if (response.IsSuccessStatusCode)
            {
                string responseBody = await response.Content.ReadAsStringAsync();
                Console.WriteLine($"Response Body: {responseBody}");
                var result = JsonConvert.DeserializeObject<DTO_Response<List<DTO_Tipo_Documento_Obten>>>(responseBody);

                if (result != null && result.IsSuccessful)
                {
                    documentos = result.Data;
                    selectedDocumento = documentos.FirstOrDefault(doc => doc.TipDoc_Nombre == cliente.TipDoc_Nombre);
                }
                else
                {
                    Console.WriteLine("Response not successful or no data.");
                }
            }
            else
            {
                Console.WriteLine($"Error: {response.StatusCode}");
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error al cargar tipos de documento: {ex.Message}";
            Console.WriteLine(ex.Message);
        }
        StateHasChanged();
    }

    private void ValidateDocumentLength(ChangeEventArgs e)
    {
        if (e.Value is string value)
        {
            if (selectedDocumento?.TipDoc_Nombre == "DNI" && value.Length > 8)
            {
                cliente.Cli_NumDocumento = value[..8];
            }
            else if (value.Length > 11)
            {
                cliente.Cli_NumDocumento = value[..11];
            }
            StateHasChanged();
        }
    }

    private async Task Guardar()
    {
        if (cliente == null || documentos == null) return;

        if (selectedDocumento?.TipDoc_Nombre == "DNI" && cliente.Cli_NumDocumento?.Length != 8)
        {
            errorMessage = "El DNI debe tener exactamente 8 dígitos";
            StateHasChanged();
            return;
        }
        else if (selectedDocumento?.TipDoc_Nombre != "DNI" && cliente.Cli_NumDocumento?.Length != 11)
        {
            errorMessage = "El número de documento debe tener exactamente 11 dígitos";
            StateHasChanged();
            return;
        }

        cliente.TipDoc_Nombre = selectedDocumento.TipDoc_Nombre;

        _processing = true;
        StateHasChanged();

        try
        {
            var client = ClientFactory.CreateClient("ApiPRESUPUESTOS");
            var token = await localStorage.GetItemAsync<string>("authToken");
            if (token != null)
            {
                client.DefaultRequestHeaders.Authorization = new AuthenticationHeaderValue("Bearer", token);
            }
            var content = new StringContent(JsonConvert.SerializeObject(cliente), System.Text.Encoding.UTF8, "application/json");
            var response = await client.PutAsync($"api/v1/Cliente/Actualiza/{Cli_Id}", content);
            if (response.IsSuccessStatusCode)
            {
                Console.WriteLine("Cliente actualizado correctamente.");
                MudDialog.Close(DialogResult.Ok(true));
            }
            else
            {
                var errorContent = await response.Content.ReadAsStringAsync();
                errorMessage = $"Error: {response.StatusCode} - {errorContent}";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Ocurrió un error: {ex.Message}";
        }
        finally
        {
            _processing = false;
            StateHasChanged();
        }
    }
    private void Cancelar()
    {
        MudDialog.Cancel();
    }
}