@page "/subpresupuesto/{Pre_Id}"
@using Newtonsoft.Json
@using MudBlazor
@using Model.DTO.v1
@inject IHttpClientFactory ClientFactory
@inject NavigationManager NavigationManager
@using Blazored.LocalStorage
@using System.Net.Http.Headers
@inject ILocalStorageService localStorage
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject IModalService model


<PageTitle>SubPresupuestos de proyecto</PageTitle>

<MudGrid>
    <MudItem xs="12">
        <MudPaper Class="pa-4" Elevation="3">
            <MudText Typo="Typo.h6" Color="Color.Primary" Class="ml-2">Sub-Presupuestos</MudText>
        </MudPaper>
    </MudItem>

    <MudItem xs="12" Class="mt-4">
        <MudPaper Class="pa-4" Elevation="3">
            <MudTable Items="@subpresupuesto"
                      FixedHeader="true"
                      Dense="true"
                      Hover="true"
                      Striped="true"
                      Breakpoint="Breakpoint.Sm"
                      Height="466px">

                <HeaderContent>
                    <MudTh Style="width: 150px;">Item</MudTh>
                    <MudTh>Nombre</MudTh>
                    <MudTh Style="width: 120px;">Acciones</MudTh>
                </HeaderContent>

                <RowTemplate>
                    <MudTd DataLabel="Item" Style="padding: 6px 8px;">
                        <div style="margin-left: @(GetIndentLevel(context.SubPre_Ruta))px">
                            @context.SubPre_Ruta
                        </div>
                    </MudTd>
                    <MudTd DataLabel="Nombre" Style="padding: 6px 8px;">
                        <div style="margin-left: @(GetIndentLevel(context.SubPre_Ruta))px">
                            @context.SubPre_Nombre
                        </div>
                    </MudTd>
                    <MudTd DataLabel="Acciones" Style="width: 250px;padding: 6px 8px;">

                        <MudIconButton Icon="@Icons.Material.Filled.Add" Variant="Variant.Filled" Color="Color.Primary" Size="Size.Medium" @onclick="@(() => Btn_Nuevo_SubPresupuesto_Click(@context.SubPre_Id))" />
                        <MudIconButton Icon="@Icons.Material.Filled.Edit" Variant="Variant.Filled" Color="Color.Primary" Size="Size.Medium" @onclick="@(() => Btn_Actualizar_SubPresupuesto_Click(@context.SubPre_Id))" />
                        <MudIconButton Icon="@Icons.Material.Filled.Delete" Variant="Variant.Filled" Color="Color.Secondary" Size="Size.Medium" @onclick="@(() => Btn_Eliminar_SubPresupuesto(@context.SubPre_Id))" />
                    </MudTd>
                </RowTemplate>

            </MudTable>
        </MudPaper>
    </MudItem>
</MudGrid>

<style>
    .compact-close-columns .mud-table-cell {
        padding: 6px 8px !important;
    }

    .compact-close-columns .mud-table-row td:first-child {
        padding-left: 16px !important;
    }

    .compact-close-columns .mud-table-row td:last-child {
        padding-right: 16px !important;
    }

    .compact-close-columns .mud-button-root {
        padding: 4px 8px !important;
        font-size: 0.75rem !important;
    }
</style>

@code {
    [Parameter] public string Pre_Id { get; set; }
    private IEnumerable<DTO_SubPresupuesto_Obten_x_Presupuesto> subpresupuesto = new List<DTO_SubPresupuesto_Obten_x_Presupuesto>();
    private bool _processing = false;
    private string errorMessage = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        var token = await localStorage.GetItemAsync<string>("authToken");
        if (string.IsNullOrEmpty(token))
        {
            NavigationManager.NavigateTo("/login");
            return;
        }
        await LoadSubPresupuestos();
    }

    private async Task LoadSubPresupuestos()
    {
        _processing = true;
        try
        {
            var client = ClientFactory.CreateClient("ApiPRESUPUESTOS");
            client.DefaultRequestHeaders.Authorization = new AuthenticationHeaderValue("Bearer",
                await localStorage.GetItemAsync<string>("authToken"));

            var response = await client.GetAsync($"api/v1/SubPresupuesto/Obten_x_Presupuesto/{Pre_Id}");

            if (response.IsSuccessStatusCode)
            {
                var responseBody = await response.Content.ReadAsStringAsync();
                var result = JsonConvert.DeserializeObject<DTO_Response<List<DTO_SubPresupuesto_Obten_x_Presupuesto>>>(responseBody);

                subpresupuesto = result?.Data ?? new List<DTO_SubPresupuesto_Obten_x_Presupuesto>();
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error: {ex.Message}";
        }
        finally
        {
            _processing = false;
            StateHasChanged();
        }
    }
    // Calcula el nivel de sangría basado en la ruta jerárquica
    private int GetIndentLevel(string ruta)
    {
        if (string.IsNullOrEmpty(ruta))
            return 0;
        // Cuenta los puntos en la ruta para determinar el nivel
        int nivel = ruta.Count(c => c == '.');
        // Sangría de 20px por nivel (ajustable)
        return nivel * 20;
    }
    private void Btn_Nuevo_SubPresupuesto_Click(string SubPre_Id)
    {
        NavigationManager.NavigateTo($"/subpresupuesto_crea/{SubPre_Id}");
    }
    private void Btn_Eliminar_SubPresupuesto(string SubPre_Id)
    {
        NavigationManager.NavigateTo($"/subpresupuesto_elimina/{SubPre_Id}");

    }
    private void Btn_Actualizar_SubPresupuesto_Click(string SubPre_Id)
    {
        NavigationManager.NavigateTo($"/subpresupuesto_actualiza/{SubPre_Id}");
    }

    
}