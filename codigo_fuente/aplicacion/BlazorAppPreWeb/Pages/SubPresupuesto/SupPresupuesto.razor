@page "/subpresupuesto/{Pre_Id}"
@using Newtonsoft.Json
@using MudBlazor
@using Model.DTO.v1
@inject IHttpClientFactory ClientFactory
@inject NavigationManager NavigationManager
@using Blazored.LocalStorage
@using System.Net.Http.Headers
@inject ILocalStorageService localStorage
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject IModalService model
@using System.Linq


<PageTitle>SubPresupuestos y Partidas de proyecto</PageTitle>

<MudGrid>
    <MudItem xs="12">
        <MudPaper Class="pa-4" Elevation="3">
            <MudGrid>
                <MudItem xs="6">
                    <MudText Typo="Typo.h5" Color="Color.Primary" Class="ml-2">@(presupuesto.Pre_Nombre ?? "N/A")</MudText>
                </MudItem>
                <MudItem xs="6" Class="ml-2">
                    <MudText Typo="Typo.h6" Color="Color.Primary">Sub-Presupuestos y Partidas</MudText>
                </MudItem>
            </MudGrid>
        </MudPaper>
    </MudItem>
    <MudItem xs="12">
        <MudPaper Class="pa-5 d-flex justify-end" Elevation="3">
            <MudSwitch T="bool"
                       @bind-Checked="disabled"
                       Color="Color.Primary"
                       Label="Editar Metrados / Cantidades"
                       Class="mt-2" />
        </MudPaper>
    </MudItem>
    <MudItem xs="12" Class="mt-4">
        <MudPaper Class="pa-4" Elevation="3">
            <MudTable Items="@combinedItems"
            FixedHeader="true"
            Dense="true"
            Hover="true"
            Striped="true"
            Breakpoint="Breakpoint.Sm"
            Height="466px"
            Loading="@isLoading">

                <HeaderContent>
                    <MudTh Style="width: 150px;">Item</MudTh>
                    <MudTh>Nombre</MudTh>
                    <MudTh Style="width: 200;">Metrado</MudTh>
                    <MudTh>Unidad</MudTh>
                    <MudTh>Precio</MudTh>
                    <MudTh>Parcial</MudTh>
                    <MudTh Style="width: 120px;">Tipo</MudTh>
                    <MudTh Style="width: 120px;">Acciones</MudTh>
                </HeaderContent>

                <RowTemplate>
                    <MudTd DataLabel="Item" Style="padding: 6px 8px;">
                        <div style="margin-left: @(GetIndentLevel(context.Ruta))px">
                            @context.Ruta
                        </div>
                    </MudTd>
                    <MudTd DataLabel="Nombre" Style="padding: 6px 8px;">
                        <div style="margin-left: @(GetIndentLevel(context.Ruta))px">
                            @context.Nombre
                        </div>
                    </MudTd>

                    <MudTd DataLabel="Metrado" Style="padding: 6px 8px; width: 200px;">
                        @if (context.EsPartida)
                        {
                            <MudNumericField T="decimal?"
                                             Value="@context.Metrado"
                                             ValueChanged="@(newValue => OnMetradoChanged(context.Id, newValue))"
                                             Label="Metrado"
                                             Required
                                             Disabled="@disabled"
                                             Style="max-width: 100px;"
                                             Immediate="true" />
                        }
                    </MudTd>
                    <MudTd DataLabel="Unidad" Style="padding: 6px 8px;">
                            @context.Unidad
                    </MudTd>
                    <MudTd DataLabel="Precio" Style="padding: 6px 8px;">
                            @context.PrecioUnitarioP
                    </MudTd>
                    <MudTd DataLabel="Parcial" Style="padding: 6px 8px;">
                        @context.PrecioUnitarioFinal
                    </MudTd>
                    <MudTd DataLabel="Tipo" Style="padding: 6px 8px;">
                        @if (context.EsPartida)
                        {
                            <MudChip Color="Color.Info" Variant="Variant.Outlined">Partida</MudChip>
                        }
                        else
                        {
                            <MudChip Color="Color.Primary" Variant="Variant.Outlined">SubPresupuesto</MudChip>
                        }
                    </MudTd>
                    <MudTd DataLabel="Acciones" Style="width: 200px; padding: 0;">
                        @if (!context.EsPartida)
                        {
                            <MudMenu Label="Acciones" Variant="Variant.Filled" Color="Color.Primary" EndIcon="@Icons.Material.Filled.ArrowDropDown">
                                @if (!HasPartidas(context.Id))
                                {
                                    <MudMenuItem OnClick="@(() => Btn_Nuevo_SubPresupuesto_Click(context.Id))">
                                        <MudIcon Icon="@Icons.Material.Filled.CreateNewFolder" Class="mr-2" />
                                        <span>Agregar SubPresupuesto</span>
                                    </MudMenuItem>
                                }

                                @if (!SubPresupuestoTieneHijos(context.Id))
                                {
                                    <MudMenuItem OnClick="@(() => NavigationManager.NavigateTo($"/partida_crea/{context.Id}"))">
                                        <MudIcon Icon="@Icons.Material.Filled.PostAdd" Class="mr-2" Color="Color.Warning" />
                                        <span style="color: var(--mud-palette-warning)">Agregar Partida</span>
                                    </MudMenuItem>
                                }

                                <MudMenuItem OnClick="@(() => Btn_Actualizar_SubPresupuesto_Click(context.Id))">
                                    <MudIcon Icon="@Icons.Material.Filled.Edit" Class="mr-2" Color="Color.Info" />
                                    <span style="color: var(--mud-palette-info)">Editar SubPresupuesto</span>
                                </MudMenuItem>

                                <MudMenuItem OnClick="@(() => Btn_Eliminar_SubPresupuesto(context.Id))" Color="Color.Error">
                                    <MudIcon Icon="@Icons.Material.Filled.Delete" Class="mr-2" />
                                    <span style="color: var(--mud-palette-error)">Eliminar SubPresupuesto</span>
                                </MudMenuItem>
                            </MudMenu>
                        }
                        else
                        {
                            <MudMenu Label="Acciones" Variant="Variant.Filled" Color="Color.Primary" EndIcon="@Icons.Material.Filled.ArrowDropDown">
                                <MudMenuItem OnClick="@(() => NavigateToPartida(context.Id))">
                                    <MudIcon Icon="@Icons.Material.Filled.RemoveRedEye" Class="mr-2" Color="Color.Info" />
                                    <span style="color: var(--mud-palette-info)">Ver Partida</span>
                                </MudMenuItem>
                            </MudMenu>
                        }
                    </MudTd>
                </RowTemplate>
                <ToolBarContent>
                    <MudToolBar>
                        <MudSpacer />
                        <MudButton Variant="Variant.Filled"
                                   Color="Color.Primary"
                                   EndIcon="@Icons.Material.Filled.Add"
                                   OnClick="@(() => Btn_Nuevo_SubPresupuestoFL_Click(Pre_Id))">
                            Agregar Subpresupuesto
                        </MudButton>
                    </MudToolBar>
                </ToolBarContent>
                <LoadingContent>
                    <MudProgressCircular Color="Color.Primary" Style="height:70px;width:70px;" Indeterminate="true" />
                </LoadingContent>

            </MudTable>
        </MudPaper>
    </MudItem>
    <MudPaper Class="pa-4" Elevation="3">
        <MudGrid>
            <MudItem xs="12">
                <MudText Typo="Typo.h5" Color="Color.Primary" Class="ml-2">Totales:</MudText>
            </MudItem>

            <MudItem xs="12" Class="d-flex justify-space-between">
                <MudText Typo="Typo.h6" Color="Color.Primary" Class="ml-2">Costo Directo:</MudText>
                <MudText Typo="Typo.h6" Color="Color.Primary" Class="mr-2">@(presupuesto.Pre_CostoDirecto)</MudText>
            </MudItem>

            <MudItem xs="12" Class="d-flex justify-space-between">
                <MudText Typo="Typo.h6" Color="Color.Primary" Class="ml-2 d-flex align-items-center">
                    Gastos Generales (%
                    <MudNumericField T="int?" @bind-Value="presupuesto.Pre_PGastosGenerales"
                                     Class="d-inline-block mx-1"
                                     Style="width: 60px;"
                                     HideSpinButtons="true"
                                     Margin="Margin.Dense"
                                     Immediate="true"
                                     Adornment="Adornment.None" />
                    ):
                </MudText>
                <MudText Typo="Typo.h6" Color="Color.Primary" Class="mr-2">
                    @(presupuesto.Pre_GastosGenerales)
                </MudText>
            </MudItem>

            <MudItem xs="12" Class="d-flex justify-space-between">
                <MudText Typo="Typo.h6" Color="Color.Primary" Class="ml-2 d-flex align-items-center">
                    Utilidad(%
                    <MudNumericField T="int?" @bind-Value="presupuesto.Pre_PUtilidad"
                                     Class="d-inline-block mx-1"
                                     Style="width: 60px;"
                                     HideSpinButtons="true"
                                     Margin="Margin.Dense"
                                     Immediate="true"
                                     Adornment="Adornment.None" />
                    ):
                </MudText>
                <MudText Typo="Typo.h6" Color="Color.Primary" Class="mr-2">
                    @(presupuesto.Pre_Utilidad)
                </MudText>
            </MudItem>

            <MudItem xs="12" Class="d-flex justify-space-between">
                <MudText Typo="Typo.h6" Color="Color.Primary" Class="ml-2">Sub Total:</MudText>
                <MudText Typo="Typo.h6" Color="Color.Primary" Class="mr-2">@(presupuesto.Pre_SubTotal)</MudText>
            </MudItem>

            <MudItem xs="12" Class="d-flex justify-space-between">
                <MudText Typo="Typo.h6" Color="Color.Primary" Class="ml-2">Impuesto IGV(% @(presupuesto.Pre_PIGV)):</MudText>
                <MudText Typo="Typo.h6" Color="Color.Primary" Class="mr-2">@(presupuesto.Pre_IGV)</MudText>
            </MudItem>

            <MudItem xs="12" Class="d-flex justify-space-between">
                <MudText Typo="Typo.h6" Color="Color.Primary" Class="ml-2">TOTAL PRESUPUESTO:</MudText>
                <MudText Typo="Typo.h6" Color="Color.Primary" Class="mr-2">@(presupuesto.Pre_TotalPresupuesto)</MudText>
            </MudItem>
        </MudGrid>
    </MudPaper>
    
</MudGrid>

@code {
    [Parameter] public string Pre_Id { get; set; }
    private IEnumerable<DTO_SubPresupuesto_Obten_x_Presupuesto> subpresupuestos = new List<DTO_SubPresupuesto_Obten_x_Presupuesto>();
    private IEnumerable<DTO_Partida_Obten_x_SubPresupuesto> partidas = new List<DTO_Partida_Obten_x_SubPresupuesto>();
    private List<CombinedItem> combinedItems = new List<CombinedItem>();
    private DTO_Presupuesto_Obten_x_Id presupuesto = new DTO_Presupuesto_Obten_x_Id();
    private DTO_Partida_Actualiza_Metrado partia_actualiza_metrado = new DTO_Partida_Actualiza_Metrado();

    private bool _processing = false;
    private string errorMessage = string.Empty;
    private bool isLoading = true;
    bool disabled = true;


    // Clase para combinar subpresupuestos y partidas
    private class CombinedItem
    {
        public string Id { get; set; }
        public string Nombre { get; set; }
        public decimal? Metrado { get; set; }
        public string Unidad { get; set; }
        public string Ruta { get; set; }
        public decimal? PrecioUnitarioP { get; set; }
        public decimal? PrecioUnitarioFinal { get; set; }
        public bool EsPartida { get; set; }
    }

    protected override async Task OnInitializedAsync()
    {
        isLoading = true;

        await LoadPresupuesto();

        var token = await localStorage.GetItemAsync<string>("authToken");
        if (string.IsNullOrEmpty(token))
        {
            NavigationManager.NavigateTo("/login");
            return;
        }

        await LoadSubPresupuestos();
        await LoadPartidas();
        CombineItems();
        isLoading = false;

    }
    private async Task OnMetradoChanged(string partidaId, decimal? newMetrado)
    {
        var partida = combinedItems.FirstOrDefault(p => p.Id == partidaId);
        if (partida != null && partida.Metrado != newMetrado)
        {
            if (newMetrado.HasValue)
            {
                var partidaActualizaMetrado = new DTO_Partida_Actualiza_Metrado
                    {
                        Par_Metrado = newMetrado.Value
                    };

                partia_actualiza_metrado = partidaActualizaMetrado;
                await Actualizar_Metrado(partidaId);
            }
        }
        
    }

    // Método para verificar si un subpresupuesto tiene partidas
    private bool HasPartidas(string subPreId)
    {
        return partidas.Any(p => p.SubPre_Id == subPreId);
    }
    private DTO_SubPresupuesto_Obten_x_Presupuesto GetSubPresupuesto(string subPreId)
    {
        return subpresupuestos.FirstOrDefault(s => s.SubPre_Id == subPreId);
    }
    private bool SubPresupuestoTieneHijos(string subPreId)
    {
        var sub = GetSubPresupuesto(subPreId);
        if (sub == null) return true;

        return !(sub.SubPre_TieneHijos == "0" ||
               string.Equals(sub.SubPre_TieneHijos, "false", StringComparison.OrdinalIgnoreCase));
    }
    private async Task LoadPresupuesto()
    {
        try
        {
            var client = ClientFactory.CreateClient("ApiPRESUPUESTOS");
            var token = await localStorage.GetItemAsync<string>("authToken");
            if (token != null)
            {
                client.DefaultRequestHeaders.Authorization = new AuthenticationHeaderValue("Bearer", token);
            }
            var response = await client.GetAsync($"api/v1/Presupuesto/Obten_x_Id/{Pre_Id}");
            if (response.IsSuccessStatusCode)
            {
                var responseBody = await response.Content.ReadFromJsonAsync<DTO_Response<DTO_Presupuesto_Obten_x_Id>>();
                if (responseBody != null && responseBody.Data != null)
                {
                    presupuesto = responseBody.Data;
                }
                else
                {
                    errorMessage = "Presupuesto no encontrado.";
                }
            }
            else
            {
                var errorContent = await response.Content.ReadAsStringAsync();
                errorMessage = $"Error: {response.StatusCode} - {errorContent}";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Ocurrió un error: {ex.Message}";
        }
    }

    private async Task LoadSubPresupuestos()
    {
        _processing = true;
        try
        {
            var client = ClientFactory.CreateClient("ApiPRESUPUESTOS");
            client.DefaultRequestHeaders.Authorization = new AuthenticationHeaderValue("Bearer",
                await localStorage.GetItemAsync<string>("authToken"));

            var response = await client.GetAsync($"api/v1/SubPresupuesto/Obten_x_Presupuesto/{Pre_Id}");

            if (response.IsSuccessStatusCode)
            {
                var responseBody = await response.Content.ReadAsStringAsync();
                var result = JsonConvert.DeserializeObject<DTO_Response<List<DTO_SubPresupuesto_Obten_x_Presupuesto>>>(responseBody);

                subpresupuestos = result?.Data ?? new List<DTO_SubPresupuesto_Obten_x_Presupuesto>();
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error: {ex.Message}";
        }
        finally
        {
            _processing = false;
            StateHasChanged();
        }
    }

    private async Task LoadPartidas()
    {
        _processing = true;
        try
        {
            var client = ClientFactory.CreateClient("ApiPRESUPUESTOS");
            client.DefaultRequestHeaders.Authorization = new AuthenticationHeaderValue("Bearer",
                await localStorage.GetItemAsync<string>("authToken"));

            // Cargar partidas para cada subpresupuesto
            var partidasList = new List<DTO_Partida_Obten_x_SubPresupuesto>();

            foreach (var sub in subpresupuestos)
            {
                var response = await client.GetAsync($"api/v1/Partida/Obten_x_SubPresupuesto/{sub.SubPre_Id}");

                if (response.IsSuccessStatusCode)
                {
                    var responseBody = await response.Content.ReadAsStringAsync();
                    var result = JsonConvert.DeserializeObject<DTO_Response<List<DTO_Partida_Obten_x_SubPresupuesto>>>(responseBody);

                    if (result?.Data != null)
                    {
                        partidasList.AddRange(result.Data);
                    }
                }
            }

            partidas = partidasList;
        }
        catch (Exception ex)
        {
            errorMessage = $"Error: {ex.Message}";
        }
        finally
        {
            _processing = false;
            StateHasChanged();
        }
    }
    private async Task Actualizar_Metrado(string partidaId)
    {
        if (!int.TryParse(partidaId, out int Par_Id))
        {
            Snackbar.Add("Error: ID de partida no válido", Severity.Error);
            return;
        }
        try
        {
            var client = ClientFactory.CreateClient("ApiPRESUPUESTOS");
            client.DefaultRequestHeaders.Authorization = new AuthenticationHeaderValue(
                "Bearer",
                await localStorage.GetItemAsync<string>("authToken")
            );

            var response = await client.PutAsJsonAsync(
                $"api/v1/Partida/Actualiza_Metrado/{Par_Id}",
                partia_actualiza_metrado
            );

            if (response.IsSuccessStatusCode)
            {
                Snackbar.Add("Metrado actualizado correctamente", Severity.Success);
                await LoadPartidas(); // Recargar datos para reflejar cambios
                CombineItems();     // Reconstruir la lista combinada
                StateHasChanged();   // Forzar actualización de UI

            }
            else
            {
                Snackbar.Add("Error al actualizar el metrado", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error: {ex.Message}", Severity.Error);
        }
    }

    private void CombineItems()
    {
        combinedItems = new List<CombinedItem>();

        // Agregar subpresupuestos
        foreach (var sub in subpresupuestos)
        {
            combinedItems.Add(new CombinedItem
                {
                    Id = sub.SubPre_Id,
                    Nombre = sub.SubPre_Nombre,
                    Ruta = sub.SubPre_Ruta,
                    EsPartida = false
                });

            // Agregar partidas de este subpresupuesto
            var partidasSub = partidas.Where(p => p.SubPre_Id == sub.SubPre_Id);
            foreach (var part in partidasSub)
            {
                combinedItems.Add(new CombinedItem
                    {
                        Id = part.Par_Id,
                        Nombre = part.Par_Nombre,
                        Unidad = part.UniMed_Abreviatura,
                        PrecioUnitarioP = part.Par_PreUnitario,
                        PrecioUnitarioFinal = part.Par_PreUnitarioFinal,
                        Metrado = part.Par_Metrado,
                        Ruta = part.Par_Ruta,
                        EsPartida = true
                    });
            }
        }

        // Ordenar por ruta
        combinedItems = combinedItems.OrderBy(x => x.Ruta).ToList();
    }

    private int GetIndentLevel(string ruta)
    {
        if (string.IsNullOrEmpty(ruta))
            return 0;

        int nivel = ruta.Count(c => c == '.');
        return nivel * 20;
    }

    private void Btn_Nuevo_SubPresupuesto_Click(string SubPre_Id)
    {
        NavigationManager.NavigateTo($"/subpresupuesto_crea/{SubPre_Id}");
    }

    private void Btn_Nuevo_Partida_Click(string SubPre_Id)
    {
        NavigationManager.NavigateTo($"/partida_crea/{SubPre_Id}");
    }

    private void Btn_Nuevo_SubPresupuestoFL_Click(string Pre_Id)
    {
        NavigationManager.NavigateTo($"/subpresupuesto_crea_fl/{Pre_Id}");
    }

    private void Btn_Eliminar_SubPresupuesto(string SubPre_Id)
    {
        NavigationManager.NavigateTo($"/subpresupuesto_elimina/{SubPre_Id}");
    }

    private void Btn_Actualizar_SubPresupuesto_Click(string SubPre_Id)
    {
        NavigationManager.NavigateTo($"/subpresupuesto_actualiza/{SubPre_Id}");
    }

    private void Btn_Actualizar_Partida_Click(string Par_Id)
    {
        NavigationManager.NavigateTo($"/partida_actualiza/{Par_Id}");
    }

    private void Btn_Eliminar_Partida_Click(string Par_Id)
    {
        NavigationManager.NavigateTo($"/partida_elimina/{Par_Id}");
    }
    private async Task NavigateToPartida(string Par_Id)
    {
        await localStorage.SetItemAsync("currentPartidaId", Par_Id);

        NavigationManager.NavigateTo("/partida", new NavigationOptions
        {
            HistoryEntryState = Par_Id
        });
    }
}