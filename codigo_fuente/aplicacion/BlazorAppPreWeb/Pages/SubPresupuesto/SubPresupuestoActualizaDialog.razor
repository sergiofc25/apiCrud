@using Model.DTO.v1
@using MudBlazor
@using System.Net.Http.Headers
@inject IHttpClientFactory ClientFactory
@using Blazored.LocalStorage
@inject ILocalStorageService localStorage
@inject ISnackbar Snackbar
@inject NavigationManager NavigationManager
@using Newtonsoft.Json
@using Microsoft.JSInterop
@using System.Globalization
@using System.Linq
@using System.Text


<MudDialog>
    <DialogContent>
        @if (subpresupuesto != null)
        {
            <MudForm @ref="form" OnValidSubmit="Guardar">
                <MudTextField @bind-Value="subpresupuesto.SubPre_Nombre"
                              Label="Nombre"
                              Required="true"
                              RequiredError="El Nombre es requerido"
                              Immediate="true" />
            </MudForm>
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancelar" Color="Color.Error">Cancelar</MudButton>
        <MudButton OnClick="Guardar" ButtonType="ButtonType.Submit" Color="Color.Primary">Guardar</MudButton>
    </DialogActions>
</MudDialog>
@code {
    [CascadingParameter] MudDialogInstance MudDialog { get; set; }
    [Parameter] public string SubPre_Id { get; set; }
    private DTO_SubPresupuesto_Obten_x_Id subpresupuesto;

    private MudForm form;
    private string errorMessage = string.Empty;
    private bool _processing = false;


    protected override async Task OnInitializedAsync()
    {
        await LoadSubPresupuesto();
    }
    private async Task LoadSubPresupuesto()
    {
        try
        {
            var client = ClientFactory.CreateClient("ApiPRESUPUESTOS");
            var token = await localStorage.GetItemAsync<string>("authToken");
            if (token != null)
            {
                client.DefaultRequestHeaders.Authorization = new AuthenticationHeaderValue("Bearer", token);
            }
            var response = await client.GetAsync($"api/v1/SubPresupuesto/Obten_x_Id/{SubPre_Id}");
            if (response.IsSuccessStatusCode)
            {
                var responseBody = await response.Content.ReadFromJsonAsync<DTO_Response<DTO_SubPresupuesto_Obten_x_Id>>();
                if (responseBody != null && responseBody.Data != null)
                {
                    subpresupuesto = responseBody.Data;
                }
                else
                {
                    errorMessage = "SubPresupuesto no encontrado.";
                }
            }
            else
            {
                var errorContent = await response.Content.ReadAsStringAsync();
                errorMessage = $"Error: {response.StatusCode} - {errorContent}";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Ocurrió un error: {ex.Message}";
        }
    }
    private async Task Guardar()
    {
        if (subpresupuesto == null) return;
        _processing = true;
        try
        {
            var client = ClientFactory.CreateClient("ApiPRESUPUESTOS");
            var token = await localStorage.GetItemAsync<string>("authToken");
            if (token != null)
            {
                client.DefaultRequestHeaders.Authorization = new AuthenticationHeaderValue("Bearer", token);
            }
            var content = new StringContent(JsonConvert.SerializeObject(subpresupuesto), System.Text.Encoding.UTF8, "application/json");
            var response = await client.PutAsync($"api/v1/SubPresupuesto/Actualiza/{SubPre_Id}", content);
            if (response.IsSuccessStatusCode)
            {
                Console.WriteLine("SubPresupuesto actualizado exitosamente");
                MudDialog.Close(DialogResult.Ok(true));
            }
            else
            {
                var errorContent = await response.Content.ReadAsStringAsync();
                errorMessage = $"Error: {response.StatusCode} - {errorContent}";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Ocurrió un error: {ex.Message}";
        }
        finally
        {
            _processing = false;
            StateHasChanged();
        }
    }
    private void Cancelar()
    {
        MudDialog.Cancel();
    }
}