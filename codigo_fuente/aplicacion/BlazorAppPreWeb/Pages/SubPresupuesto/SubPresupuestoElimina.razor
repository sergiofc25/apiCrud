@page "/subpresupuesto_elimina/{SubPre_Id}"
@using Newtonsoft.Json
@using MudBlazor
@using Model.DTO.v1
@using Blazored.LocalStorage
@using System.Net.Http.Headers
@inject IHttpClientFactory ClientFactory
@inject NavigationManager NavigationManager
@inject ILocalStorageService localStorage
@inject ISnackbar Snackbar
@inject IDialogService DialogService

<PageTitle>Eliminar SubPresupuesto</PageTitle>

<section style="max-width:600px; margin: 0 auto;">
    <MudGrid>
        <MudItem xs="12">
            <MudPaper Class="pa-5" Elevation="3">
                @if (subpresupuesto != null)
                {
                    <MudText Typo="Typo.h6" Class="mb-4">Confirmar eliminación</MudText>
                    <MudText Class="mb-4">¿Está seguro que desea eliminar el siguiente subpresupuesto?</MudText>

                    <MudTable Dense="true" Hover="true" Class="mb-4" Items="@(new List<DTO_SubPresupuesto_Obten_x_Id> { subpresupuesto })" T="DTO_SubPresupuesto_Obten_x_Id">
                        <HeaderContent>
                            <MudTh>Ruta</MudTh>
                            <MudTh>Nombre</MudTh>
                        </HeaderContent>
                        <RowTemplate>
                            <MudTd>@context.SubPre_Ruta</MudTd>
                            <MudTd>@context.SubPre_Nombre</MudTd>
                        </RowTemplate>
                    </MudTable>

                    <MudItem Class="d-flex justify-center align-center" xs="12">
                        <MudButton Variant="Variant.Filled"
                                   Color="Color.Error"
                                   Size="Size.Small"
                                   Disabled="@_processing"
                                   EndIcon="@Icons.Material.Filled.Delete"
                                   OnClick="@(async () => await EliminarSubPresupuesto())"
                                   Style="margin-right: 10px;">
                            @if (_processing)
                            {
                                <MudProgressCircular Class="ms-n1" Size="Size.Small" Indeterminate="true" Color="Color.Inherit" />
                                <MudText Class="ms-2">Eliminando...</MudText>
                            }
                            else
                            {
                                <MudText>Confirmar Eliminación</MudText>
                            }
                        </MudButton>
                        <MudButton Variant="Variant.Filled"
                                   StartIcon="@Icons.Material.Filled.ArrowCircleLeft"
                                   Color="Color.Primary"
                                   Size="Size.Small"
                                   OnClick="VolverALista"
                                   Disabled="@_processing">
                            VOLVER
                        </MudButton>
                    </MudItem>
                }
                else if (!string.IsNullOrEmpty(errorMessage))
                {
                    <MudAlert Severity="Severity.Error">@errorMessage</MudAlert>
                    <MudButton Variant="Variant.Filled"
                               StartIcon="@Icons.Material.Filled.ArrowCircleLeft"
                               Color="Color.Primary"
                               Size="Size.Small"
                               OnClick="VolverALista">
                        VOLVER
                    </MudButton>
                }
                else
                {
                    <MudProgressCircular Indeterminate="true" Color="Color.Primary" Class="mx-auto d-block" />
                }
            </MudPaper>
        </MudItem>
    </MudGrid>
</section>

@code {
    [Parameter] public string SubPre_Id { get; set; }
    private DTO_SubPresupuesto_Obten_x_Id subpresupuesto;
    private bool _processing = false;
    private string errorMessage = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        var token = await localStorage.GetItemAsync<string>("authToken");
        if (string.IsNullOrEmpty(token))
        {
            NavigationManager.NavigateTo("/login");
            return;
        }

        await CargarSubPresupuesto();
    }

    private async Task CargarSubPresupuesto()
    {
        _processing = true;
        try
        {
            var client = ClientFactory.CreateClient("ApiPRESUPUESTOS");
            client.DefaultRequestHeaders.Authorization = new AuthenticationHeaderValue("Bearer",
                await localStorage.GetItemAsync<string>("authToken"));

            var response = await client.GetAsync($"api/v1/SubPresupuesto/Obten_x_Id/{SubPre_Id}");

            if (response.IsSuccessStatusCode)
            {
                var responseBody = await response.Content.ReadAsStringAsync();
                var result = JsonConvert.DeserializeObject<DTO_Response<DTO_SubPresupuesto_Obten_x_Id>>(responseBody);
                subpresupuesto = result?.Data;
            }
            else
            {
                errorMessage = $"Error al cargar subpresupuesto: {response.ReasonPhrase}";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error: {ex.Message}";
        }
        finally
        {
            _processing = false;
            StateHasChanged();
        }
    }

    private async Task EliminarSubPresupuesto()
    {

        _processing = true;
        StateHasChanged();

        try
        {
            var client = ClientFactory.CreateClient("ApiPRESUPUESTOS");
            client.DefaultRequestHeaders.Authorization = new AuthenticationHeaderValue("Bearer",
                await localStorage.GetItemAsync<string>("authToken"));

            var response = await client.DeleteAsync($"api/v1/SubPresupuesto/Elimina/{SubPre_Id}");

            if (response.IsSuccessStatusCode)
            {
                Snackbar.Add("Subpresupuesto eliminado correctamente", Severity.Success);
                VolverALista();
            }
            else
            {
                var errorContent = await response.Content.ReadAsStringAsync();
                errorMessage = $"Error al eliminar: {errorContent}";
                Snackbar.Add(errorMessage, Severity.Error);
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error: {ex.Message}";
            Snackbar.Add(errorMessage, Severity.Error);
        }
        finally
        {
            _processing = false;
            StateHasChanged();
        }
    }

    private void VolverALista()
    {
        NavigationManager.NavigateTo($"/subpresupuesto/{subpresupuesto?.Pre_Id ?? "0"}");
    }
}