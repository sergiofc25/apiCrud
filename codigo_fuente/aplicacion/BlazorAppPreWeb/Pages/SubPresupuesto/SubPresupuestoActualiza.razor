@page "/subpresupuesto_actualiza/{SubPre_Id}"
@using Newtonsoft.Json
@using MudBlazor
@using Model.DTO.v1
@inject IHttpClientFactory ClientFactory
@inject NavigationManager NavigationManager
@using Blazored.LocalStorage
@using System.Net.Http.Headers
@inject ILocalStorageService localStorage
@using Microsoft.JSInterop
@inject IJSRuntime JSRuntime


<PageTitle>Actualizar SubPresupuesto</PageTitle>

<section style="max-width:600px; margin: 0 auto;">
    <MudGrid>
        <MudItem xs="12">
            <MudPaper Class="pa-5" Elevation="3">
                @if (subpresupuesto != null)
                {
                    <MudForm Model="@subpresupuesto" @ref="form" OnValidSubmit="ActualizarSubPresupuesto">
                        <MudTextField @bind-Value="subpresupuesto.SubPre_Nombre" Label="Nombre" Required="true" Class="mud-width-full" />

                            <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small" Disabled="@_processing" EndIcon="@Icons.Material.Filled.Send" OnClick="@(async () => await ActualizarSubPresupuesto())">
                                @if (_processing)
                                {
                                    <MudProgressCircular Class="ms-n1" Size="Size.Small" Indeterminate="true" Color="Color.Inherit" />
                                    <MudText Class="ms-2">Actualizando...</MudText>
                                }
                                else
                                {
                                    <MudText>Actualizar</MudText>
                                }
                            </MudButton>
                    </MudForm>
                }
                else if (!string.IsNullOrEmpty(errorMessage))
                {
                    <MudAlert Severity="Severity.Error">@errorMessage</MudAlert>
                }
            </MudPaper>
        </MudItem>
    </MudGrid>
</section>

@code {
    [Parameter] public string SubPre_Id { get; set; }
    private DTO_SubPresupuesto_Obten_x_Id subpresupuesto;
    private MudForm? form;
    private bool _processing = false;
    private string errorMessage = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        await LoadSubPresupuesto();

    }

    private async Task LoadSubPresupuesto()
    {
        try
        {
            var client = ClientFactory.CreateClient("ApiPRESUPUESTOS");
            var token = await localStorage.GetItemAsync<string>("authToken");
            if (token != null)
            {
                client.DefaultRequestHeaders.Authorization = new AuthenticationHeaderValue("Bearer", token);
            }
            var response = await client.GetAsync($"api/v1/SubPresupuesto/Obten_x_Id/{SubPre_Id}");
            if (response.IsSuccessStatusCode)
            {
                var responseBody = await response.Content.ReadFromJsonAsync<DTO_Response<DTO_SubPresupuesto_Obten_x_Id>>();
                if (responseBody != null && responseBody.Data != null)
                {
                    subpresupuesto = responseBody.Data;
                }
                else
                {
                    errorMessage = "SubPresupuesto no encontrado.";
                }
            }
            else
            {
                var errorContent = await response.Content.ReadAsStringAsync();
                errorMessage = $"Error: {response.StatusCode} - {errorContent}";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Ocurrió un error: {ex.Message}";
        }
    }
    private async Task ActualizarSubPresupuesto()
    {
        if (subpresupuesto == null) return;
        _processing = true;
        StateHasChanged(); // Actualiza el UI para mostrar el estado de procesamiento

        try
        {
            var client = ClientFactory.CreateClient("ApiPRESUPUESTOS");
            var token = await localStorage.GetItemAsync<string>("authToken");
            if (token != null)
            {
                client.DefaultRequestHeaders.Authorization = new AuthenticationHeaderValue("Bearer", token);
            }
            var content = new StringContent(JsonConvert.SerializeObject(subpresupuesto), System.Text.Encoding.UTF8, "application/json");
            var response = await client.PutAsync($"api/v1/SubPresupuesto/Actualiza/{SubPre_Id}", content);
            if (response.IsSuccessStatusCode)
            {
                //NavigationManager.NavigateTo("/proyectos_paginado");
                await JSRuntime.InvokeVoidAsync("history.back");
            }
            else
            {
                var errorContent = await response.Content.ReadAsStringAsync();
                errorMessage = $"Error: {response.StatusCode} - {errorContent}";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Ocurrió un error: {ex.Message}";
        }
        finally
        {
            _processing = false;
            StateHasChanged(); // Actualiza el UI para ocultar el estado de procesamiento
        }
    }
}
