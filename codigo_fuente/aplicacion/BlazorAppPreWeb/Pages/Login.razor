@page "/login"
@using System.Net.Http.Json
@using Model.DTO.v1
@using MudBlazor
@inject IHttpClientFactory ClientFactory
@inject NavigationManager NavigationManager
@using Blazored.LocalStorage
@using System.Net.Http.Headers
@inject ILocalStorageService localStorage
@layout LoginLayout


<PageTitle>Login - Sistema Web SFC</PageTitle>

<MudGrid Class="full-height">
    <MudItem xs="12" md="8" Class="d-flex flex-column justify-center align-center pa-10">
        <div class="welcome-content">
            <MudText Typo="Typo.h3" Class="mb-4" Color="Color.Primary">
                Bienvenido al Sistema Web De Análisis de Precios Unitarios
            </MudText>
            <MudText Typo="Typo.h5" Class="mb-6" Color="Color.Secondary">
                Gestión Integral de Proyectos
            </MudText>

            <div class="features-list">
                <MudText Class="d-flex align-center mb-3">
                    <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Color="Color.Success" Class="mr-2" />
                    Acceso seguro
                </MudText>
                <MudText Class="d-flex align-center mb-3">
                    <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Color="Color.Success" Class="mr-2" />
                    Panel de control intuitivo
                </MudText>
                <MudText Class="d-flex align-center mb-3">
                    <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Color="Color.Success" Class="mr-2" />
                    Analisis de costos
                </MudText>
            </div>

            <MudPaper Class="mt-10 pa-4" Elevation="0" Style="background-color: rgba(255,255,255,0.1); border-radius: 16px;">
                <MudText Align="Align.Center" Class="mb-2">¿Necesitas ayuda?</MudText>
                <MudButton Variant="Variant.Outlined" Color="Color.Info" FullWidth="true"
                           EndIcon="@Icons.Material.Filled.ContactSupport">
                    Contactar al soporte
                </MudButton>
            </MudPaper>
        </div>
    </MudItem>

    <MudItem xs="12" md="4" Class="login-section">
        <MudPaper Class="pa-8 full-height" Elevation="10" Style="border-radius: 0;">
            <div class="d-flex flex-column justify-space-between full-height">
                <div>
                    <div class="text-center mb-6">
                        <MudAvatar Size="Size.Large" Color="Color.Primary" Style="margin: 0 auto;">
                            <MudIcon Icon="@Icons.Material.Filled.Lock" Size="Size.Large" />
                        </MudAvatar>
                        <MudText Typo="Typo.h5" Class="mt-3" Color="Color.Primary">Inicio de Sesión</MudText>
                        <MudText Class="mt-2" Color="Color.Secondary">Ingresa tus credenciales para continuar</MudText>
                    </div>

                    <MudForm @ref="form">
                        <MudTextField @bind-Value="loginModel.Usu_Correo"
                                      Label="Usuario"
                                      Variant="Variant.Outlined"
                                      Margin="Margin.Dense"
                                      FullWidth="true"
                                      Required="true"
                                      AdornmentIcon="@Icons.Material.Filled.Person"
                                      Class="mb-4" />

                        <MudTextField @bind-Value="loginModel.Usu_Clave"
                                      Label="Contraseña"
                                      Variant="Variant.Outlined"
                                      Margin="Margin.Dense"
                                      FullWidth="true"
                                      Required="true"
                                      InputType="InputType.Password"
                                      AdornmentIcon="@Icons.Material.Filled.Lock"
                                      Class="mb-4" />

                        <div class="text-right mb-4">
                            <MudLink Href="#" Color="Color.Primary" Underline="Underline.Hover">
                                ¿Olvidaste tu contraseña?
                            </MudLink>
                        </div>

                        <MudButton Type="Submit"
                                   Variant="Variant.Filled"
                                   Color="Color.Primary"
                                   Size="Size.Small"
                                   EndIcon="@Icons.Material.Filled.Send"
                                   Disabled="isProcessing"
                                   OnClick="async () => await HandleLogin()"
                                   Class="mb-4" Style="width: 100%;">
                            @if (isProcessing)
                            {
                                <MudProgressCircular Class="ms-n1" Size="Size.Small" Indeterminate="true" Color="Color.Inherit" />
                                <MudText Class="ms-2">Ingresando...</MudText>
                            }
                            else
                            {
                                <MudText>Iniciar Sesión</MudText>
                            }
                        </MudButton>
                        <MudButton Variant="Variant.Filled"
                                   Color="Color.Default"
                                   Size="Size.Small"
                                   EndIcon="@Icons.Material.Filled.Person"
                                   Disabled="isProcessing"
                                   OnClick="async () => await LoginAsGuest()"
                                   Class="mb-4" Style="width: 100%;">
                            <MudText>Ingresar como Invitado</MudText>
                        </MudButton>
                        @if (!string.IsNullOrEmpty(errorMessage))
                        {
                            <MudAlert Severity="Severity.Error" Class="mt-4">@errorMessage</MudAlert>
                        }
                    </MudForm>
                </div>

                <div class="text-center mt-6">
                    <MudText Color="Color.Secondary" Class="mb-2">© @DateTime.Now.Year Sistema Web SFC</MudText>
                    <MudText Color="Color.Secondary" Typo="Typo.caption">v3.0.0</MudText>
                </div>
            </div>
        </MudPaper>
    </MudItem>
</MudGrid>

<style>
    body {
        margin: 0;
        padding: 0;
        background-size: cover;
    }

    .full-height {
        height: 100vh;
        margin: 0;
    }

    .login-section {

    }

    .welcome-content {
        max-width: 1000px;
        border-radius: 8px;
        color: black;
    }

    .features-list {
        margin: 2rem 0;
        padding: 1rem;
        border-radius: 8px;
        color: black;
    }
</style>
@code {
    private DTO_Usuario_Obten_Login loginModel = new DTO_Usuario_Obten_Login();
    private string errorMessage = string.Empty;
    private bool isProcessing = false;
    private MudForm? form;
    private Breakpoint Breakpoint { get; set; } = Breakpoint.Sm;


    private async Task HandleLogin()
    {
        if (form.IsValid)
        {
            isProcessing = true;
            StateHasChanged();  // Actualiza el UI para mostrar el estado de procesamiento
            try
            {
                var client = ClientFactory.CreateClient("ApiPRESUPUESTOS");
                var response = await client.PostAsJsonAsync("api/v1/Accounts/Login", loginModel);

                if (response.IsSuccessStatusCode)
                {
                    var result = await response.Content.ReadFromJsonAsync<DTO_AuthResponse>();

                    if (result != null && result.IsAuthSuccessful)
                    {
                        // Almacenar el token en el almacenamiento local
                        localStorage.SetItemAsync("authToken", result.Token);
                        NavigationManager.NavigateTo("/clientes_paginado", forceLoad: true);
                    }
                    else
                    {
                        errorMessage = result?.ErrorMessage ?? "Error desconocido";
                    }
                }
                else
                {
                    var errorContent = await response.Content.ReadAsStringAsync();
                    errorMessage = $"Error en la solicitud de autenticación: {response.StatusCode} - {response.ReasonPhrase}. Detalles: {errorContent}";
                }
            }
            catch (Exception ex)
            {
                errorMessage = $"Ocurrió un error: {ex.Message}";
            }
            finally
            {
                isProcessing = false;
                StateHasChanged();  // Actualiza el UI para ocultar el estado de procesamiento
            }
        }
    }
    private async Task LoginAsGuest()
    {
        isProcessing = true;
        StateHasChanged();

        try
        {
            var client = ClientFactory.CreateClient("ApiPRESUPUESTOS");
            var response = await client.PostAsJsonAsync("api/v1/Accounts/Login", new DTO_Usuario_Obten_Login
                {
                    Usu_Correo = "Invitado",
                    Usu_Clave = "invitado123"
                });

            if (response.IsSuccessStatusCode)
            {
                var result = await response.Content.ReadFromJsonAsync<DTO_AuthResponse>();
                if (result?.IsAuthSuccessful == true)
                {
                    await localStorage.SetItemAsync("authToken", result.Token);
                    NavigationManager.NavigateTo("/clientes_paginado");
                    return;
                }
            }
            errorMessage = "Error al acceder como invitado";
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            isProcessing = false;
            StateHasChanged();
        }
    }

}
