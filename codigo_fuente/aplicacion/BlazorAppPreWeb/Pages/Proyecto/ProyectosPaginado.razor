@page "/proyectos_paginado"
@using System.Net.Http.Json
@using System.Text.Json
@inject NavigationManager NavigationManager
@inject IHttpClientFactory ClientFactory
@using Model.DTO.v1
@using MudBlazor
@using System.Text
@using Blazored.LocalStorage
@using System.Net.Http.Headers
@inject ILocalStorageService localStorage
@inject IModalService model
@inject IDialogService DialogService
@inject UserStateService UserStateService

<PageTitle>Proyectos Paginados</PageTitle>


<MudGrid>
    <MudItem xs="12">
        <MudPaper Class="pa-5" Elevation="3">
            <MudItem Class="d-flex align-center justify-center mud-width-full" xs="12">
                <MudItem Class="d-flex align-center justify-start mud-width-full" xs="6">
                    <MudText Typo="Typo.h6" Color="Color.Primary">Proyectos</MudText>
                </MudItem>

                <MudItem Class="d-flex align-center justify-end mud-width-full" xs="6">
                    <MudButton Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.AddBox" Color="Color.Primary"
                    Size="Size.Small" OnClick="Btn_Nuevo_Proyecto_Click">NUEVO</MudButton>
                </MudItem>
            </MudItem>
        </MudPaper>
    </MudItem>

    <MudItem xs="12">
        <MudPaper Class="pa-5" Elevation="3">
            <MudTable Items="@presupuestos" RowsPerPage="@registroPagina" FixedHeader="true" Dense="true"
            Hover="true" Striped="true" Breakpoint="Breakpoint.Sm" Loading="@cargando"
            LoadingProgressColor="Color.Primary" Height="466px" Elevation="3">
                <ToolBarContent>
                    <MudText Typo="Typo.h6">Listado de Proyectos</MudText>
                </ToolBarContent>
                <ToolBarContent>
                    <MudItem Class="d-flex align-center justify-center mud-width-full pb-5" xs="12">
                        <MudTextField T="string" Value="@searchTerm" ValueChanged="@(value => OnSearch(value))"
                        Placeholder="Buscar por Nombre" Adornment="Adornment.Start"
                        AdornmentIcon="@Icons.Material.Filled.Search" IconSize="Size.Medium" Class="mt-0">
                        </MudTextField>
                    </MudItem>
                </ToolBarContent>
                <HeaderContent>

                    <MudTh>Codigo</MudTh>
                    <MudTh>Usuario</MudTh>
                    <MudTh>Nombre</MudTh>
                    <MudTh>Cliente</MudTh>
                    <MudTh>Jornal</MudTh>
                    <MudTh>Pais</MudTh>
                    <MudTh>Departamento</MudTh>
                    <MudTh>Provincia</MudTh>
                    <MudTh>Distrito</MudTh>
                    <MudTh>Acciones</MudTh>
                </HeaderContent>
                <RowTemplate>

                    <MudTd DataLabel="Codigo">@context.Pre_Codigo</MudTd>
                    <MudTd DataLabel="Usuario">@context.Usu_NomApellidos</MudTd>
                    <MudTd DataLabel="Nombre">@context.Pre_Nombre</MudTd>
                    <MudTd DataLabel="Cliente">@context.Cli_NomApeRazSocial</MudTd>
                    <MudTd DataLabel="Jornal">@context.Pre_Jornal</MudTd>
                    <MudTd DataLabel="Pais">@context.Pai_Nombre</MudTd>
                    <MudTd DataLabel="Departamento">@context.Dep_Nombre</MudTd>
                    <MudTd DataLabel="Provincia">@context.Prov_Nombre</MudTd>
                    <MudTd DataLabel="Distrito">@context.Dist_Nombre</MudTd>
                    <MudTd DataLabel="Acciones">
                        @if (UserStateService.CurrentUser?.Rol_Nombre == "Invitado")
                        {
                            <MudIconButton Icon="@Icons.Material.Filled.RemoveRedEye"
                            Variant="Variant.Filled"
                            Color="Color.Warning"
                            Size="Size.Medium"
                            @onclick="@(() => Btn_Mostrar_SubPresupuestos_Click(@context.Pre_Id))" />
                            <MudIconButton Icon="@Icons.Material.Filled.Edit"
                            Variant="Variant.Filled"
                            Color="Color.Primary"
                            Disabled="true"
                            Size="Size.Medium"
                            @onclick="@(() => Btn_Actualizar_Proyecto_Click(@context.Pre_Id))" />
                            <MudIconButton Icon="@Icons.Material.Filled.Delete"
                            @onclick="@(() => Btn_Eliminar_Proyecto_Click(context))"
                            Variant="Variant.Filled"
                            Color="Color.Error"
                            Disabled="true"
                            Title="Eliminar proyecto">
                            </MudIconButton>
                        }
                        else
                        {
                            <MudIconButton Icon="@Icons.Material.Filled.RemoveRedEye"
                                           Variant="Variant.Filled"
                                           Color="Color.Warning"
                                           Size="Size.Medium"
                                           @onclick="@(() => Btn_Mostrar_SubPresupuestos_Click(@context.Pre_Id))" />
                            <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                           Variant="Variant.Filled"
                                           Color="Color.Primary"
                                           Size="Size.Medium"
                                           @onclick="@(() => Btn_Actualizar_Proyecto_Click(@context.Pre_Id))" />
                            <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                           @onclick="@(() => Btn_Eliminar_Proyecto_Click(context))"
                                           Variant="Variant.Filled"
                                           Color="Color.Error"
                                           Title="Eliminar proyecto">
                            </MudIconButton>
                        }

                    </MudTd>
                </RowTemplate>
                <PagerContent>
                    <div class="d-flex flex-column align-center">
                        <MudPagination Size="Size.Small" Rectangular="true" Variant="Variant.Text" BoundaryCount="1"
                                       MiddleCount="3" Count="@metaData.TotalPagina" SelectedChanged="PageChanged" Class="pa-4" />
                    </div>
                </PagerContent>
                <NoRecordsContent>
                    <MudText>No se encontraron registros.</MudText>
                </NoRecordsContent>
                <LoadingContent>
                    <MudText>Un momento por favor...</MudText>
                </LoadingContent>
            </MudTable>
        </MudPaper>
    </MudItem>
</MudGrid>

@code {
    private IEnumerable<DTO_Presupuesto_Obten_Paginado> presupuestos;
    private MetaData metaData = new MetaData();
    private int registroPagina = 10;
    private int numeroPagina = 1;
    private string searchTerm = string.Empty;
    private bool cargando = true;
    private string errorMessage = string.Empty;


    protected override async Task OnInitializedAsync()
    {
        var token = await localStorage.GetItemAsync<string>("authToken");
        if (string.IsNullOrEmpty(token))
        {
            NavigationManager.NavigateTo("/login");
            return;
        }
        await LoadClients();
    }

    private async Task LoadClients()
    {
        try
        {
            cargando = true;
            var client = ClientFactory.CreateClient("ApiPRESUPUESTOS");

            // Agregar el token de autorización a la solicitud actual
            var token = await localStorage.GetItemAsync<string>("authToken");
            if (token != null)
            {
                client.DefaultRequestHeaders.Authorization = new AuthenticationHeaderValue("Bearer", token);
            }
            var requestUri = $"api/v1/Presupuesto/Obten_Paginado/{registroPagina}/{numeroPagina}";

            if (!string.IsNullOrWhiteSpace(searchTerm))
            {
                requestUri += $"?PorNombre={Uri.EscapeDataString(searchTerm)}";
            }

            var response = await client.GetAsync(requestUri);

            if (response.IsSuccessStatusCode)
            {
                var metadataHeader = response.Headers.GetValues("X-Pagination").FirstOrDefault();
                if (metadataHeader != null)
                {
                    metaData = JsonSerializer.Deserialize<MetaData>(metadataHeader);
                }

                var responseBody = await response.Content.ReadFromJsonAsync<DTO_ResponsePag<IEnumerable<DTO_Presupuesto_Obten_Paginado>>>();
                if (responseBody != null && responseBody.IsSuccessful)
                {
                    presupuestos = responseBody.Data;
                }
            }
            else
            {
                Console.WriteLine($"Error: {response.StatusCode}");
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine(ex.Message);
        }
        finally
        {
            cargando = false;
            StateHasChanged();
        }
    }
    private async Task EliminarProyecto(DTO_Presupuesto_Obten_Paginado proyecto)
    {
        if (proyecto == null) return;

        cargando = true;
        StateHasChanged();

        try
        {
            var client = ClientFactory.CreateClient("ApiPRESUPUESTOS");
            var token = await localStorage.GetItemAsync<string>("authToken");

            if (token != null)
            {
                client.DefaultRequestHeaders.Authorization = new AuthenticationHeaderValue("Bearer", token);
            }

            var requestData = new { Pre_Id = proyecto.Pre_Id, Pre_Estado = "False" };
            var content = new StringContent(JsonSerializer.Serialize(requestData), Encoding.UTF8, "application/json");

            var response = await client.PutAsync($"api/v1/Presupuesto/Actualiza_Condicion/{proyecto.Pre_Id}", content);

            if (response.IsSuccessStatusCode)
            {
                await LoadClients();

            }
            else
            {
                var errorContent = await response.Content.ReadAsStringAsync();
                errorMessage = $"Error: {response.StatusCode} - {errorContent}";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Ocurrió un error: {ex.Message}";
        }
        finally
        {
            cargando = false;
            StateHasChanged();
        }
    }
    private async Task Btn_Eliminar_Proyecto_Click(DTO_Presupuesto_Obten_Paginado proyecto)
    {
        var options = new DialogOptions()
            {
                CloseOnEscapeKey = true,
                CloseButton = true,
                FullWidth = true
            };

        var parameters = new DialogParameters();
        parameters.Add("Proyecto", proyecto);

        var dialog = DialogService.Show<ProyectoEliminaDialog>("Eliminar Proyecto", parameters, options);
        var result = await dialog.Result;

        if (!result.Cancelled && result.Data is bool confirmado && confirmado)
        {
            await EliminarProyecto(proyecto);
        }
    }

    private void PageChanged(int page)
    {
        numeroPagina = page;
        _ = LoadClients();
    }

    private void OnSearch(string searchTerm)
    {
        this.searchTerm = searchTerm;
        numeroPagina = 1; // Reset to first page when searching
        _ = LoadClients();
    }

    private void Btn_Nuevo_Proyecto_Click()
    {
        NavigationManager.NavigateTo("/proyecto_crea");
    }
    private void Btn_Mostrar_SubPresupuestos_Click(string Pre_Id)
    {
        NavigationManager.NavigateTo($"/subpresupuesto/{Pre_Id}");
    }
    private void Btn_Actualizar_Proyecto_Click(string Pre_Id)
    {
        NavigationManager.NavigateTo($"/proyecto_actualiza/{Pre_Id}");
    }

}
