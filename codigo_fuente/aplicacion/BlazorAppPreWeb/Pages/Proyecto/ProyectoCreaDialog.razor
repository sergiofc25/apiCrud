@using Model.DTO.v1
@using MudBlazor
@using System.Net.Http.Headers
@inject IHttpClientFactory ClientFactory
@using Blazored.LocalStorage
@inject ILocalStorageService localStorage
@inject ISnackbar Snackbar
@inject NavigationManager NavigationManager
@using Newtonsoft.Json
@using Microsoft.JSInterop
@using System.Globalization
@using System.Linq
@using System.Text
@inject IDialogService DialogService


<MudDialog>
    <DialogContent>
        <MudForm @ref="form" Validation="@formValidation">
            <MudGrid>
                <MudItem xs="12" md="6">
                    <MudTextField @bind-Value="usuario.Usu_NomApellidos" 
                    Label="Usuario" 
                    Required="true" 
                    Class="mud-width-full" 
                    Variant="Variant.Outlined" 
                    ReadOnly="true" 
                    Immediate="true" />
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudTextField @bind-Value="proyecto.Pre_Nombre" 
                    Label="Nombre" 
                    Required="true" 
                    Class="mud-width-full"
                    Immediate="true" />
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudAutocomplete T="DTO_Cliente_Obten_Nombre"
                                     Label="Buscar cliente"
                                     @bind-Value="selectedCliente"
                                     ToStringFunc="@(cli => cli?.Cli_NomApeRazSocial ?? "Seleccione cliente")"
                                     SearchFunc="@SearchClientes"
                                     Dense="true"
                                     Class="mud-width-full" /> 
                </MudItem>
                <MudItem xs="12" md="4">
                    <MudAutocomplete T="DTO_Pais_Obten"
                                     Label="Buscar país"
                                     @bind-Value="selectedPais"
                                     ToStringFunc="@(pai => pai?.Pai_Nombre ?? "Seleccione país")"
                                     SearchFunc="@SearchPais"
                                     Dense="true"
                                     Class="mud-width-full"
                                     @oninput="async () => await OnPaisSelected()"
                                     Items="@pais" />
                </MudItem>
                <MudItem xs="12" md="6">
                    @* <MudAutocomplete T="DTO_Departamento_Obten"
                                     Label="Buscar departamento"
                                     Value="selectedDepartamento"
                                     ValueChanged="OnDepartamentoSelected"
                                     ValueExpression="@(() => selectedDepartamento)"
                                     ToStringFunc="@(dep => dep?.Dep_Nombre ?? "Seleccione departamento")"
                                     SearchFunc="@SearchDepartamento"
                                     Dense="true"
                                     Class="mud-width-full"
                                     Disabled="@(selectedPais == null)"
                                     Immediate="true">
                    </MudAutocomplete> *@
                    <MudAutocomplete T="DTO_Departamento_Obten"
                                     Label="Buscar departamento"
                                     ValueChanged="OnDepartamentoSelected"
                                     ToStringFunc="@(dep => dep?.Dep_Nombre ?? "Seleccione departamento")"
                                     SearchFunc="@SearchDepartamento"
                                     Dense="true"
                                     Class="mud-width-full"
                                     Disabled="@(selectedPais == null)"
                                     Immediate="true">
                    </MudAutocomplete>
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudAutocomplete T="DTO_Provincia_Obten"
                                     Label="Buscar provincia"
                                     Value="selectedProvincia"
                                     ValueChanged="OnProvinciaSelected"
                                     ValueExpression="@(() => selectedProvincia)"
                                     ToStringFunc="@(prov => prov?.Prov_Nombre ?? "Seleccione provincia")"
                                     SearchFunc="@SearchProvincia"
                                     Dense="true"
                                     Class="mud-width-full"
                                     Disabled="@(selectedDepartamento == null)"
                                     Immediate="true">
                    </MudAutocomplete>
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudAutocomplete T="DTO_Distrito_Obten"
                                     Label="Buscar distrito"
                                     ValueChanged="OnDistritoSelected"
                                     ValueExpression="@(() => selectedDistrito)"
                                     ToStringFunc="@(dist => dist?.Dist_Nombre ?? "Seleccione distrito")"
                                     SearchFunc="@SearchDistrito"
                                     Dense="true"
                                     Class="mud-width-full"
                                     Disabled="@(selectedProvincia == null)"
                                     @key="selectedProvincia?.Prov_Nombre"
                                     Immediate="true">
                    </MudAutocomplete>
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudTextField @bind-Value="proyecto.Pre_Jornal" 
                    Label="Jornal" 
                    Required="true" 
                    InputType="InputType.Number" 
                    Class="mud-width-full"
                    Immediate="true" />
                </MudItem>
            </MudGrid>
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancelar" Color="Color.Error">Cancelar</MudButton>
        <MudButton OnClick="Guardar" Color="Color.Primary" Disabled="form == null || !form.IsValid">Guardar</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] MudDialogInstance MudDialog { get; set; }

    private MudForm? form;
    private DTO_Presupuesto_Crea proyecto = new DTO_Presupuesto_Crea();
    private List<DTO_Cliente_Obten_Nombre> clientes = new List<DTO_Cliente_Obten_Nombre>();
    private DTO_Cliente_Obten_Nombre selectedCliente { get; set; } = new DTO_Cliente_Obten_Nombre();
    private DTO_Usuario_Obten_x_Correo usuario = new DTO_Usuario_Obten_x_Correo();
    private List<DTO_Pais_Obten> pais = new List<DTO_Pais_Obten>();
    private DTO_Pais_Obten selectedPais { get; set; } = new DTO_Pais_Obten();
    private DTO_Departamento_Obten selectedDepartamento;
    private List<DTO_Departamento_Obten> departamento = new();
    private DTO_Provincia_Obten selectedProvincia;
    private List<DTO_Provincia_Obten> provincia = new();
    private DTO_Distrito_Obten selectedDistrito;
    private List<DTO_Distrito_Obten> distrito = new();


    private string errorMessage = string.Empty;
    private bool _processing = false;

    private bool formValidation = true;
    private bool guardando = false;

    protected override async Task OnInitializedAsync()
    {
        await GetUsuario();
        await GetCliente();
        await GetPais();
        if (selectedPais != null)
        {
            await GetDepartamentosByPais(selectedPais.Pai_Nombre);
        }
        if (selectedDepartamento != null)
        {
            await GetProvinciasByDepartamento(selectedDepartamento.Dep_Nombre);
        }
        if (selectedProvincia != null)
        {
            await GetDistritoByProvincia(selectedProvincia.Prov_Nombre);
        }

    }

    private async Task<IEnumerable<DTO_Cliente_Obten_Nombre>> SearchClientes(string searchText)
    {
        if (string.IsNullOrEmpty(searchText))
            return clientes;

        return clientes.Where(cli => cli.Cli_NomApeRazSocial.Contains(searchText, StringComparison.OrdinalIgnoreCase));
    }
    private async Task<IEnumerable<DTO_Pais_Obten>> SearchPais(string searchText)
    {
        if (string.IsNullOrEmpty(searchText))
            return pais;

        return pais.Where(pai => pai.Pai_Nombre.Contains(searchText, StringComparison.OrdinalIgnoreCase));
    }
    private async Task<IEnumerable<DTO_Departamento_Obten>> SearchDepartamento(string searchText)
    {
        if (string.IsNullOrEmpty(searchText))
            return departamento;

        return departamento
            .Where(dep => dep.Dep_Nombre.Contains(searchText, StringComparison.OrdinalIgnoreCase))
            .ToList();
    }
    private async Task<IEnumerable<DTO_Provincia_Obten>> SearchProvincia(string searchText)
    {
        if (string.IsNullOrEmpty(searchText))
            return provincia;

        return provincia.Where(prov => prov.Prov_Nombre.Contains(searchText, StringComparison.OrdinalIgnoreCase));
    }
    private async Task<IEnumerable<DTO_Distrito_Obten>> SearchDistrito(string searchText)
    {
        if (string.IsNullOrEmpty(searchText))
            return distrito;

        return distrito.Where(dist => dist.Dist_Nombre.Contains(searchText, StringComparison.OrdinalIgnoreCase));
    }
    private async Task GetUsuario()
    {
        try
        {
            var client = ClientFactory.CreateClient("ApiPRESUPUESTOS");
            var token = await localStorage.GetItemAsync<string>("authToken");
            if (!string.IsNullOrEmpty(token))
            {
                client.DefaultRequestHeaders.Authorization = new AuthenticationHeaderValue("Bearer", token);
            }

            var response = await client.GetAsync("api/v1/Usuario/Obten_Usuario_Logeado");
            Console.WriteLine($"Response Status: {response.StatusCode}");

            if (response.IsSuccessStatusCode)
            {
                string responseBody = await response.Content.ReadAsStringAsync();
                Console.WriteLine($"Response Body: {responseBody}");
                var result = JsonConvert.DeserializeObject<DTO_Response<DTO_Usuario_Obten_x_Correo>>(responseBody);

                if (result != null && result.IsSuccessful)
                {
                    usuario = result.Data;
                    Console.WriteLine($"Usuario Count: {usuario.ToString}");

                }
                else
                {
                    Console.WriteLine("Response not successful or no data.");
                }
            }
            else
            {
                Console.WriteLine($"Error: {response.StatusCode}");
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error al cargar usuario: {ex.Message}";
            Console.WriteLine(ex.Message);
        }
        StateHasChanged();
    }

    private async Task GetCliente()
    {
        try
        {
            var client = ClientFactory.CreateClient("ApiPRESUPUESTOS");
            var token = await localStorage.GetItemAsync<string>("authToken");
            if (token != null)
            {
                client.DefaultRequestHeaders.Authorization = new AuthenticationHeaderValue("Bearer", token);
            }

            var response = await client.GetAsync("api/v1/Cliente/Obten_Nombre");
            Console.WriteLine($"Response Status: {response.StatusCode}");

            if (response.IsSuccessStatusCode)
            {
                string responseBody = await response.Content.ReadAsStringAsync();
                Console.WriteLine($"Response Body: {responseBody}");
                var result = JsonConvert.DeserializeObject<DTO_Response<List<DTO_Cliente_Obten_Nombre>>>(responseBody);

                if (result != null && result.IsSuccessful)
                {
                    clientes = result.Data;
                    Console.WriteLine($"Cliente Count: {clientes.Count}");
                }
                else
                {
                    Console.WriteLine("Response not successful or no data.");
                }
            }
            else
            {
                Console.WriteLine($"Error: {response.StatusCode}");
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error al cargar nombres de clientes: {ex.Message}";
            Console.WriteLine(ex.Message);
        }
        StateHasChanged();
    }
    private async Task GetPais()
    {
        try
        {
            var client = ClientFactory.CreateClient("ApiPRESUPUESTOS");
            var token = await localStorage.GetItemAsync<string>("authToken");
            if (token != null)
            {
                client.DefaultRequestHeaders.Authorization = new AuthenticationHeaderValue("Bearer", token);
            }

            var response = await client.GetAsync("api/v1/Pais/Obten");

            if (response.IsSuccessStatusCode)
            {
                var responseBody = await response.Content.ReadAsStringAsync();
                var result = JsonConvert.DeserializeObject<DTO_Response<List<DTO_Pais_Obten>>>(responseBody);

                if (result != null && result.IsSuccessful)
                {
                    pais = result.Data;
                    selectedPais = pais.FirstOrDefault(p => p.Pai_Nombre == "PERU");
                }
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error al cargar países: {ex.Message}";
        }
    }
    private async Task OnPaisSelected()
    {
        selectedDepartamento = null;

        if (selectedPais != null)
        {
            await GetDepartamentosByPais(selectedPais.Pai_Nombre);
        }
        else
        {
            departamento.Clear();
        }
        StateHasChanged();
    }
    private async Task GetDepartamentosByPais(string paisNombre)
    {
        try
        {
            var client = ClientFactory.CreateClient("ApiPRESUPUESTOS");
            var token = await localStorage.GetItemAsync<string>("authToken");

            if (!string.IsNullOrEmpty(token))
            {
                client.DefaultRequestHeaders.Authorization = new AuthenticationHeaderValue("Bearer", token);
            }

            var response = await client.GetAsync($"api/v1/Departamento/Obten/{Uri.EscapeDataString(paisNombre)}");

            if (response.IsSuccessStatusCode)
            {
                var responseBody = await response.Content.ReadAsStringAsync();
                var result = JsonConvert.DeserializeObject<DTO_Response<List<DTO_Departamento_Obten>>>(responseBody);

                if (result?.IsSuccessful == true)
                {
                    departamento = result.Data ?? new List<DTO_Departamento_Obten>();
                }
                else
                {
                    errorMessage = "No se pudieron obtener los departamentos";
                    departamento.Clear();
                }
            }
            else
            {
                errorMessage = $"Error: {response.StatusCode}";
                departamento.Clear();
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error al cargar departamentos: {ex.Message}";
            departamento.Clear();
        }
        StateHasChanged();
    }

    private async Task OnDepartamentoSelected(DTO_Departamento_Obten nuevoDepartamento)
    {
        selectedDepartamento = nuevoDepartamento;
        selectedProvincia = null;
        provincia = new List<DTO_Provincia_Obten>();

        if (selectedDepartamento != null && !string.IsNullOrEmpty(selectedDepartamento.Dep_Nombre))
        {
            Console.WriteLine($"Cargando provincias para: {selectedDepartamento.Dep_Nombre}");
            await GetProvinciasByDepartamento(selectedDepartamento.Dep_Nombre);
        }
        await InvokeAsync(StateHasChanged);
    }
    private async Task GetProvinciasByDepartamento(string departamentoNombre)
    {
        try
        {
            var client = ClientFactory.CreateClient("ApiPRESUPUESTOS");
            var token = await localStorage.GetItemAsync<string>("authToken");

            if (!string.IsNullOrEmpty(token))
            {
                client.DefaultRequestHeaders.Authorization = new AuthenticationHeaderValue("Bearer", token);
            }

            var response = await client.GetAsync($"api/v1/Provincia/Obten/{Uri.EscapeDataString(departamentoNombre)}");

            if (response.IsSuccessStatusCode)
            {
                var responseBody = await response.Content.ReadAsStringAsync();
                var result = JsonConvert.DeserializeObject<DTO_Response<List<DTO_Provincia_Obten>>>(responseBody);

                if (result?.IsSuccessful == true)
                {
                    provincia = result.Data ?? new List<DTO_Provincia_Obten>();
                }
                else
                {
                    errorMessage = "No se pudieron obtener las provincias";
                    provincia.Clear();
                }
            }
            else
            {
                errorMessage = $"Error: {response.StatusCode}";
                provincia.Clear();
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error al cargar provincias: {ex.Message}";
            provincia.Clear();
        }
        StateHasChanged();
    }
    private async Task OnProvinciaSelected(DTO_Provincia_Obten nuevoProvincia)
    {
        selectedProvincia = nuevoProvincia;
        selectedDistrito = null;
        distrito = new List<DTO_Distrito_Obten>();

        if (selectedProvincia != null && !string.IsNullOrEmpty(selectedProvincia.Prov_Nombre))
        {
            Console.WriteLine($"Cargando departamentos para: {selectedProvincia.Prov_Nombre}");
            await GetDistritoByProvincia(selectedProvincia.Prov_Nombre);
        }
        await InvokeAsync(StateHasChanged);
    }

    private async Task GetDistritoByProvincia(string provinciaNombre)
    {
        try
        {
            var client = ClientFactory.CreateClient("ApiPRESUPUESTOS");
            var token = await localStorage.GetItemAsync<string>("authToken");

            if (!string.IsNullOrEmpty(token))
            {
                client.DefaultRequestHeaders.Authorization = new AuthenticationHeaderValue("Bearer", token);
            }

            var response = await client.GetAsync($"api/v1/Distrito/Obten/{Uri.EscapeDataString(provinciaNombre)}");

            if (response.IsSuccessStatusCode)
            {
                var responseBody = await response.Content.ReadAsStringAsync();
                var result = JsonConvert.DeserializeObject<DTO_Response<List<DTO_Distrito_Obten>>>(responseBody);

                if (result?.IsSuccessful == true)
                {
                    distrito = result.Data ?? new List<DTO_Distrito_Obten>();
                }
                else
                {
                    errorMessage = "No se pudieron obtener los distritos";
                    distrito.Clear();
                }
            }
            else
            {
                errorMessage = $"Error: {response.StatusCode}";
                distrito.Clear();
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error al cargar departamentos: {ex.Message}";
            distrito.Clear();
        }
        StateHasChanged();
    }
    private async Task OnDistritoSelected(DTO_Distrito_Obten nuevoDistrito)
    {
        selectedDistrito = nuevoDistrito;
        await InvokeAsync(StateHasChanged);
    }
    private async Task Guardar()
    {
        if (form != null && form.IsValid)
        {
            _processing = true;
            StateHasChanged();

            try
            {
                var proyectoParaEnviar = new
                {
                    Usu_NomApellidos = usuario.Usu_NomApellidos,
                    Pre_Nombre = proyecto.Pre_Nombre,
                    Cli_NomApeRazSocial = selectedCliente?.Cli_NomApeRazSocial,
                    Pai_Nombre = selectedPais?.Pai_Nombre,
                    Dep_Nombre = selectedDepartamento?.Dep_Nombre,
                    Prov_Nombre = selectedProvincia?.Prov_Nombre,
                    Dist_Nombre = selectedDistrito?.Dist_Nombre,
                    Pre_Jornal = proyecto.Pre_Jornal
                };

                var client = ClientFactory.CreateClient("ApiPRESUPUESTOS");
                var token = await localStorage.GetItemAsync<string>("authToken");
                if (token != null)
                {
                    client.DefaultRequestHeaders.Authorization = new AuthenticationHeaderValue("Bearer", token);
                }

                var content = new StringContent(JsonConvert.SerializeObject(proyectoParaEnviar),
                    Encoding.UTF8, "application/json");

                var response = await client.PostAsync("api/v1/Presupuesto/Crea", content);
                Console.WriteLine($"Response Status: {response.StatusCode}");

                if (response.IsSuccessStatusCode)
                {
                    Console.WriteLine("Proyecto creado exitosamente.");
                    MudDialog.Close(DialogResult.Ok(true));
                }
                else
                {
                    var errorContent = await response.Content.ReadAsStringAsync();
                    errorMessage = $"Error: {response.StatusCode} - {errorContent}";
                    Console.WriteLine(errorMessage);
                }
            }
            catch (Exception ex)
            {
                errorMessage = $"Ocurrió un error: {ex.Message}";
                Console.WriteLine(ex.Message);
            }
            finally
            {
                _processing = false;
                StateHasChanged();
            }
        }
    }

    private void Cancelar()
    {
        MudDialog.Cancel();
    }
}