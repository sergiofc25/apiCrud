    private async Task CrearApu()
    {
        _processing = true;
        StateHasChanged();

        try
        {
            // 1. Crear el DTO con los valores correctamente formateados
            var requestBody = new
            {
                eDTO_Recurso_Crea_APU = new
                {
                    Par_Id = Par_Id?.ToString(),
                    Rec_Id = selectedRecurso?.Rec_Id?.ToString(),
                    Rec_Cantidad = string.IsNullOrWhiteSpace(recursoAPU.Rec_Cantidad?.ToString())
                        ? null
                        : decimal.Parse(recursoAPU.Rec_Cantidad.ToString()).ToString(CultureInfo.InvariantCulture),
                    Rec_Cuadrilla = string.IsNullOrWhiteSpace(recursoAPU.Rec_Cuadrilla?.ToString())
                        ? null
                        : decimal.Parse(recursoAPU.Rec_Cuadrilla.ToString()).ToString(CultureInfo.InvariantCulture),
                    DRP_Precio = string.IsNullOrWhiteSpace(recursoAPU.DRP_Precio?.ToString())
                        ? null
                        : decimal.Parse(recursoAPU.DRP_Precio.ToString()).ToString(CultureInfo.InvariantCulture)
                }
            };

            // 2. Configuración del serializador simplificada
            var settings = new JsonSerializerSettings
                {
                    NullValueHandling = NullValueHandling.Include,
                    Formatting = Formatting.Indented,
                    Culture = CultureInfo.InvariantCulture
                };

            // 3. Serialización
            var jsonContent = JsonConvert.SerializeObject(requestBody, settings);
            Console.WriteLine("JSON enviado:");
            Console.WriteLine(jsonContent);

            // 4. Configuración del cliente HTTP
            var client = ClientFactory.CreateClient("ApiPRESUPUESTOS");
            var token = await localStorage.GetItemAsync<string>("authToken");
            if (token != null)
            {
                client.DefaultRequestHeaders.Authorization = new AuthenticationHeaderValue("Bearer", token);
            }

            // 5. Envío de la solicitud (con la URL corregida)
            var content = new StringContent(jsonContent, Encoding.UTF8, "application/json");
            var response = await client.PostAsync("api/v1/Recurso/Crea_APU", content);

            // 6. Manejo de la respuesta
            if (response.IsSuccessStatusCode)
            {
                Console.WriteLine("Partida creada exitosamente.");
                await JSRuntime.InvokeVoidAsync("history.back");
            }
            else
            {
                var errorContent = await response.Content.ReadAsStringAsync();
                errorMessage = $"Error: {response.StatusCode} - {errorContent}";
                Console.WriteLine($"Error en la respuesta: {errorMessage}");
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error: {ex.Message}";
            Console.WriteLine($"Excepción: {ex.Message}");
            if (ex.InnerException != null)
            {
                Console.WriteLine($"Inner exception: {ex.InnerException.Message}");
            }
        }
        finally
        {
            _processing = false;
            StateHasChanged();
        }
    }
