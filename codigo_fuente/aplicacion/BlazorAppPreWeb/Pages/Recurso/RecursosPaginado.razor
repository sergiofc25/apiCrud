@page "/recursos_paginado"
@using System.Net.Http.Json
@using System.Text.Json
@using MudBlazor
@using Model.DTO.v1
@inject IHttpClientFactory ClientFactory
@inject NavigationManager NavigationManager
@using Blazored.LocalStorage
@using System.Net.Http.Headers
@using System.Text
@using System.Net
@using System.Reflection.Metadata
@inject ILocalStorageService localStorage
@using Microsoft.JSInterop
@inject IJSRuntime JSRuntime
@using System.Globalization;
@using System.Linq
@inject IDialogService DialogService
@inject UserStateService UserStateService


<PageTitle>Recursos</PageTitle>

<MudGrid>
    <MudItem xs="12">
        <MudPaper Class="pa-5" Elevation="3">
            <MudItem Class="d-flex align-center justify-center mud-width-full" xs="12">
                <MudItem Class="d-flex align-center justify-start mud-width-full" xs="6">
                    <MudText Typo="Typo.h6" Color="Color.Primary">Recursos</MudText>
                </MudItem>

                <MudItem Class="d-flex align-center justify-end mud-width-full" xs="6">
                    <MudButton Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.AddBox" Color="Color.Primary"
                    Size="Size.Small" @onclick="@(() => Btn_Nuevo_Recurso_Click())">NUEVO</MudButton>
                </MudItem>
            </MudItem>
        </MudPaper>
    </MudItem>

    <MudItem xs="12">
        <MudPaper Class="pa-5" Elevation="3">
            <MudTable Items="@recursos" RowsPerPage="@registroPagina" FixedHeader="true" Dense="true"
            Hover="true" Striped="true" Breakpoint="Breakpoint.Sm" Loading="@cargando"
            LoadingProgressColor="Color.Primary" Height="466px" Elevation="3">
                <ToolBarContent>
                    <MudText Typo="Typo.h6">Listado de Recursos</MudText>
                </ToolBarContent>
                <ToolBarContent>
                    <MudItem Class="d-flex align-center justify-center mud-width-full pb-5" xs="12">
                        <MudTextField T="string" Value="@searchTerm" ValueChanged="@(value => OnSearch(value))"
                        Placeholder="Buscar por Nombre o Código" Adornment="Adornment.Start"
                        AdornmentIcon="@Icons.Material.Filled.Search" IconSize="Size.Medium" Class="mt-0">
                        </MudTextField>
                    </MudItem>
                </ToolBarContent>
                <HeaderContent>

                    <MudTh>Código</MudTh>
                    <MudTh>Nombre</MudTh>
                    <MudTh>Unidad de Medida</MudTh>
                    <MudTh>Tipo</MudTh>
                    <MudTh>Acciones</MudTh>
                </HeaderContent>
                <RowTemplate>

                    <MudTd DataLabel="Código">@context.Rec_IndUnificado</MudTd>
                    <MudTd DataLabel="Nombre">@context.Rec_Nombre</MudTd>
                    <MudTd DataLabel="Unidad de Medida">@context.UniMed_Abreviatura</MudTd>
                    <MudTd DataLabel="Tipo">@context.TipRec_Nombre</MudTd>
                    <MudTd DataLabel="Acciones">
                        @if(UserStateService.CurrentUser?.Rol_Nombre == "Invitado")
                        {
                            <MudIconButton Icon="@Icons.Material.Filled.Edit"
                            Variant="Variant.Filled"
                            Color="Color.Primary"
                            Disabled="true"
                            Size="Size.Small" @onclick="@(() => Btn_Actualizar_Recurso_Click(@context.Rec_Id))">
                            </MudIconButton>
                            <MudIconButton Icon="@Icons.Material.Filled.Delete"
                            @onclick="@(() => OpenDialogAsyncEliminaRecurso(context))"
                            Variant="Variant.Filled"
                            Color="Color.Error"
                            Disabled="true"
                            Title="Eliminar recurso">
                            </MudIconButton>
                        }
                        else
                        {
                            <MudIconButton Icon="@Icons.Material.Filled.Edit" 
                                        Variant="Variant.Filled" 
                                        Color="Color.Primary" 
                                        Size="Size.Small" @onclick="@(() => Btn_Actualizar_Recurso_Click(@context.Rec_Id))">
                            </MudIconButton>
                            <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                           @onclick="@(() => OpenDialogAsyncEliminaRecurso(context))"
                                           Variant="Variant.Filled"
                                           Color="Color.Error"
                                           Disabled="@(context.Rec_Estado == "False")"
                                           Title="Eliminar recurso">
                            </MudIconButton>
                        }
                    </MudTd>
                </RowTemplate>
                <PagerContent>
                    <div class="d-flex flex-column align-center">
                        <MudPagination Size="Size.Small" Rectangular="true" Variant="Variant.Text" BoundaryCount="1"
                                       MiddleCount="3" Count="@metaData.TotalPagina" SelectedChanged="PageChanged" Class="pa-4" />
                    </div>
                </PagerContent>
                <NoRecordsContent>
                    <MudText>No se encontraron registros.</MudText>
                </NoRecordsContent>
                <LoadingContent>
                    <MudText>Un momento por favor...</MudText>
                </LoadingContent>
            </MudTable>
        </MudPaper>
    </MudItem>
</MudGrid>

@code {
    private IEnumerable<DTO_Recurso_Obten_Paginado> recursos;
    private MetaData metaData = new MetaData();
    private int registroPagina = 10;
    private int numeroPagina = 1;
    private string searchTerm = string.Empty;
    private bool cargando = true;
    private string errorMessage = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        var token = await localStorage.GetItemAsync<string>("authToken");
        if (string.IsNullOrEmpty(token))
        {
            NavigationManager.NavigateTo("/login");
            return;
        }
        await LoadRecursos();
    }

    private async Task LoadRecursos()
    {
        try
        {
            cargando = true;
            var client = ClientFactory.CreateClient("ApiPRESUPUESTOS");

            var token = await localStorage.GetItemAsync<string>("authToken");
            if (token != null)
            {
                client.DefaultRequestHeaders.Authorization = new AuthenticationHeaderValue("Bearer", token);
            }
            var requestUri = $"api/v1/Recurso/Obten_Paginado/{registroPagina}/{numeroPagina}";

            if (!string.IsNullOrWhiteSpace(searchTerm))
            {
                requestUri += $"?PorNombre={Uri.EscapeDataString(searchTerm)}";
            }

            var response = await client.GetAsync(requestUri);

            if (response.IsSuccessStatusCode)
            {
                var metadataHeader = response.Headers.GetValues("X-Pagination").FirstOrDefault();
                if (metadataHeader != null)
                {
                    metaData = JsonSerializer.Deserialize<MetaData>(metadataHeader);
                }

                var responseBody = await response.Content.ReadFromJsonAsync<DTO_ResponsePag<IEnumerable<DTO_Recurso_Obten_Paginado>>>();
                if (responseBody != null && responseBody.IsSuccessful)
                {
                    recursos = responseBody.Data;
                }
            }
            else
            {
                Console.WriteLine($"Error: {response.StatusCode}");
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine(ex.Message);
        }
        finally
        {
            cargando = false;
            StateHasChanged();
        }
    }

    private void PageChanged(int page)
    {
        numeroPagina = page;
        _ = LoadRecursos();
    }

    private void OnSearch(string searchTerm)
    {
        this.searchTerm = searchTerm;
        numeroPagina = 1;
        _ = LoadRecursos();
    }
    private async Task EliminarRecurso(DTO_Recurso_Obten_Paginado recurso)
    {
        if (recurso == null) return;

        cargando = true;
        StateHasChanged();

        try
        {
            var client = ClientFactory.CreateClient("ApiPRESUPUESTOS");
            var token = await localStorage.GetItemAsync<string>("authToken");

            if (token != null)
            {
                client.DefaultRequestHeaders.Authorization = new AuthenticationHeaderValue("Bearer", token);
            }

            var requestData = new { Rec_Id = recurso.Rec_Id, Rec_Estado = "False" };
            var content = new StringContent(JsonSerializer.Serialize(requestData), Encoding.UTF8, "application/json");

            var response = await client.PutAsync($"api/v1/Recurso/Actualiza_Condicion/{recurso.Rec_Id}", content);

            if (response.IsSuccessStatusCode)
            {
                await LoadRecursos();

                // await JSRuntime.InvokeVoidAsync("alert", "Recurso eliminado correctamente");
            }
            else
            {
                var errorContent = await response.Content.ReadAsStringAsync();
                errorMessage = $"Error: {response.StatusCode} - {errorContent}";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Ocurrió un error: {ex.Message}";
        }
        finally
        {
            cargando = false;
            StateHasChanged();
        }
    }

    private async Task OpenDialogAsyncEliminaRecurso(DTO_Recurso_Obten_Paginado recurso)
    {
        var options = new DialogOptions()
            {
                CloseOnEscapeKey = true,
                CloseButton = true,
                FullWidth = true
            };

        var parameters = new DialogParameters();
        parameters.Add("Recurso", recurso);

        var dialog = DialogService.Show<RecursoElimina>("Eliminar Recurso", parameters, options);
        var result = await dialog.Result;

        if (!result.Cancelled && result.Data is bool confirmado && confirmado)
        {
            await EliminarRecurso(recurso);
        }
    }
    private async Task Btn_Nuevo_Recurso_Click()
    {
        var options = new DialogOptions()
            {
                CloseOnEscapeKey = true,
                CloseButton = true,
                FullWidth = true,
                MaxWidth = MaxWidth.Small
            };

        var dialog = DialogService.Show<RecursoCreaDialog>("Crear Nuevo Recurso", options);
        var result = await dialog.Result;

        if (!result.Cancelled)
        {
            await LoadRecursos();
        }
    }

    private async Task Btn_Actualizar_Recurso_Click(string rec_Id)
    {
        var options = new DialogOptions()
            {
                CloseOnEscapeKey = true,
                CloseButton = true,
                FullWidth = true,
                MaxWidth = MaxWidth.Small
            };

        var parameters = new DialogParameters();
        parameters.Add("Rec_Id", rec_Id);

        var dialog = DialogService.Show<RecursoActualizaDialog>("Actualizar Recurso", parameters, options);
        var result = await dialog.Result;

        if (!result.Cancelled)
        {
            await LoadRecursos();
        }
    }
}
