@page "/inicio"
@layout InicioLayout
 
<MudContainer Class=" mt-16">
    <MudText Typo="Typo.h3"
             Align="Align.Center"
             GutterBottom="true"
             Style="color: #1A237E;">
        Nosotros
    </MudText>
    <MudText Typo="Typo.h6"
             Align="Align.Center"
             GutterBottom="true"
             Style="color: black;">
        Nuestra misión es construir digna y honestamente su necesidad, cuidando la calidad del trabajo final y el presupuesto óptimo para ejecutarla.
        Marcamos el inicio de la actividad con la Asesoría que ofrecemos desde nuestra Oficina Técnica.
    </MudText>
    <MudGrid Class="mt-8">
    </MudGrid>
</MudContainer>
<MudContainer Class="mt-16">
    <MudText Typo="Typo.h3"
             Align="Align.Center"
             GutterBottom="true"
             Style="color: #1A237E;">
        Servicios
    </MudText>
    <MudGrid Class="mt-8">
        <MudCarousel Class="mud-width-full" Style="height:600px;" TData="object" AutoCycle="false">
            <MudCarouselItem Color="@Color.Transparent" Transition="Transition.Slide">
                <div class="d-flex justify-center align-center" style="height:100%">
                    <MudImage Src="/ImagenesC/Servicios1.png"
                              Fluid="true"
                              Class="h-100"
                              Style="object-fit: contain;"
                              Alt="Servicios1" />
                </div>
            </MudCarouselItem>
            <MudCarouselItem Color="@Color.Transparent" Transition="Transition.Fade">
                <div class="d-flex justify-center align-center" style="height:100%">
                    <MudImage Src="/ImagenesC/Servicios2.png"
                              Fluid="true"
                              Class="h-100"
                              Style="object-fit: contain;"
                              Alt="Servicios2" />
                </div>
            </MudCarouselItem>
            <MudCarouselItem Color="@Color.Transparent" Transition="Transition.Custom" CustomTransitionEnter="bounceIn" CustomTransitionExit="bounceOut">
                <div class="d-flex justify-center align-center" style="height:100%">
                    <MudImage Src="/ImagenesC/Servicios3.png"
                              Fluid="true"
                              Class="h-100"
                              Style="object-fit: contain;"
                              Alt="Servicios3" />
                </div>
            </MudCarouselItem>
            <MudCarouselItem Color="@Color.Transparent" Transition="Transition.Custom" CustomTransitionEnter="backInDown" CustomTransitionExit="backOutDown">
                <div class="d-flex justify-center align-center" style="height:100%">
                    <MudImage Src="/ImagenesC/Servicios4.png"
                              Fluid="true"
                              Class="h-100"
                              Style="object-fit: contain;"
                              Alt="Servicios4" />
                </div>
            </MudCarouselItem>
        </MudCarousel>
    </MudGrid>
</MudContainer>
<MudContainer Class="mt-16">
    <MudText Typo="Typo.h3"
             Align="Align.Center"
             GutterBottom="true"
             Style="color: #1A237E;">
        Proyectos
    </MudText>
    <MudGrid Class="mt-8">
        <MudCarousel Class="mud-width-full" Style="height:600px;" TData="object" AutoCycle="false">
            <MudCarouselItem Color="@Color.Transparent" Transition="Transition.Slide">
                <div class="d-flex justify-center align-center" style="height:100%">
                    <MudImage Src="/ImagenesC/Proyecto2.png"
                              Fluid="true"
                              Class="h-100"
                              Style="object-fit: contain;"
                              Alt="Proyecto2" />
                </div>
            </MudCarouselItem>
            <MudCarouselItem Color="@Color.Transparent" Transition="Transition.Fade">
                <div class="d-flex justify-center align-center" style="height:100%">
                    <MudImage Src="/ImagenesC/Proyecto3.png"
                              Fluid="true"
                              Style="object-fit: contain;"
                              Alt="Proyecto3" />
                </div>
            </MudCarouselItem>
            <MudCarouselItem Color="@Color.Transparent" Transition="Transition.Custom" CustomTransitionEnter="bounceIn" CustomTransitionExit="bounceOut">
                <div class="d-flex justify-center align-center" style="height:100%">
                    <MudImage Src="/ImagenesC/Proyecto4.png"
                              Fluid="true"
                              Class="h-100"
                              Style="object-fit: contain;"
                              Alt="Proyecto4" />
                </div>
            </MudCarouselItem>
            <MudCarouselItem Color="@Color.Transparent" Transition="Transition.Custom" CustomTransitionEnter="backInDown" CustomTransitionExit="backOutDown">
                <div class="d-flex justify-center align-center" style="height:100%">
                    <MudImage Src="/ImagenesC/Proyecto5.png"
                              Fluid="true"
                              Class="h-100"
                              Style="object-fit: contain;"
                              Alt="Proyecto5" />
                </div>
            </MudCarouselItem>
            <MudCarouselItem Color="@Color.Transparent" Transition="Transition.Custom" CustomTransitionEnter="rotateIn" CustomTransitionExit="rotateOut">
                <div class="d-flex justify-center align-center" style="height:100%">
                    <MudImage Src="/ImagenesC/Proyecto6.png"
                              Fluid="true"
                              Class="h-100"
                              Style="object-fit: contain;"
                              Alt="Proyecto6" />
                </div>
            </MudCarouselItem>
        </MudCarousel>
    </MudGrid>
</MudContainer>
<MudContainer Class="mt-16">
    <MudText Typo="Typo.h3"
             Align="Align.Center"
             GutterBottom="true"
             Style="color: #1A237E;">
    </MudText>
    <MudGrid Class="mt-8">
    </MudGrid>
</MudContainer>
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/animate.css/4.1.1/animate.min.css" />
<style type="text/css">

    .bounceIn {
        opacity: 0;
        animation-delay: 0.5s;
        animation-duration: 0.5s;
        animation-name: bounceIn;
        animation-fill-mode: forwards;
    }

    .bounceOut {
        animation-duration: 0.5s;
        animation-name: bounceOut;
        animation-fill-mode: forwards;
    }

    .backInDown {
        opacity: 0;
        animation-delay: 0.5s;
        animation-duration: 0.5s;
        animation-name: backInDown;
        animation-fill-mode: forwards;
    }

    .backOutDown {
        animation-duration: 0.5s;
        animation-name: backOutDown;
        animation-fill-mode: forwards;
    }

    .rotateIn {
        opacity: 0;
        animation-delay: 0.5s;
        animation-duration: 0.5s;
        animation-name: rotateIn;
        animation-fill-mode: forwards;
    }

    .rotateOut {
        animation-duration: 0.5s;
        animation-name: rotateOut;
        animation-fill-mode: forwards;
    }
</style>
